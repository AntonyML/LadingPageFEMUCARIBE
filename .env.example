# FEMUCARIBE Landing Page - Environment Variables Template
# Copy this file to .env and configure values before starting the application.

# Administrator Credentials
ADMIN_EMAIL=soporte@femucaribe.go.cr
ADMIN_PASSWORD=your_secure_password_here

# Session Secret (HMAC-SHA256 signature key for cookies)
SESSION_SECRET=generate_a_random_32_bytes_hex_secret_here

# Document Storage API (api-buket integration)
FEMUCARIBE_STORAGE_ENDPOINT=http://127.0.0.1:3005
FEMUCARIBE_STORAGE_API_KEY=your_api_key_from_api_buket_here

# Writable municipal data file; default: data/municipalities-data.json from process cwd.
# Use an absolute path on a persistent volume in standalone deployments.
# MUNICIPALITIES_DATA_FILE=/var/lib/femucaribe/municipalities-data.json

# Writable documents metadata file; default: data/documents-manifest.json from process cwd.
# Use an absolute path on a persistent volume in standalone deployments.
# DOCUMENTS_MANIFEST_PATH=/var/lib/femucaribe/documents-manifest.json
