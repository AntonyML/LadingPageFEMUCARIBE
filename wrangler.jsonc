{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ladingpagefemucaribe",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "local-session-kv"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "femucaribe-db",
      "database_id": "local-femucaribe-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS_BUCKET",
      "bucket_name": "femucaribe-documents"
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  }
}
