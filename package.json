{
  "name": "ladingpagefemucaribe",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,astro}\" --allow-empty-input",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "format": "prettier --write src tests \"*.{json,mjs,ts,yaml}\"",
    "format:check": "prettier --check src tests \"*.{json,mjs,ts,yaml}\"",
    "test:unit": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.12.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
