---
import SiteIcon from './SiteIcon.astro';

const resources = [
  {
    icon: 'scroll',
    title: 'Acuerdos del Consejo',
    description: 'Actas oficiales y resoluciones',
  },
  {
    icon: 'construction',
    title: 'Cartera UGP',
    description: 'Inversión pública en territorio',
  },
  {
    icon: 'landmark',
    title: 'Directorio Municipal',
    description: 'Autoridades y 6 cantones',
  },
  {
    icon: 'chart',
    title: 'Compras en SICOP',
    description: 'Transparencia y licitaciones',
  },
] as const;
---

<section class="home-quick-access" aria-labelledby="quick-access-title">
  <h2 class="visually-hidden" id="quick-access-title">
    Accesos directos
  </h2>
  <ul class="layout-grid links">
    {resources.map(({ icon, title, description }) => (
      <li>
        <div class="card">
          <h3 class="title">
            <span class="title-icon">
              <SiteIcon name={icon} size={18} />
            </span>
            {title}
          </h3>
          <span class="description">{description}</span>
          <span class="status">Recurso pendiente</span>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .home-quick-access {
    margin-block: 0.1875rem;
    padding-block: 0.625rem;
  }

  .links {
    gap: 1.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    justify-content: center;
    min-inline-size: 0;
    block-size: 100%;
    min-block-size: 5.625rem;
    padding: 1rem 1.125rem;
    color: var(--theme-text);
    background: var(--theme-surface-muted);
    border: 1px solid var(--theme-border);
    border-radius: 0.625rem;
  }

  .title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .title-icon {
    display: inline-flex;
    margin-inline-end: 0.25rem;
    color: var(--theme-link);
    vertical-align: -0.15em;
  }

  .description,
  .status {
    font-size: 0.875rem;
    line-height: 1.2;
    color: var(--theme-text-muted);
  }

  @media (width >= 75rem) {
    .links {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .title {
      font-size: 0.8438rem;
    }

    .description,
    .status {
      font-size: 0.7188rem;
    }
  }
</style>
