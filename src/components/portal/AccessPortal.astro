---
interface Props {
  adminUrl?: string;
}

const { adminUrl = 'https://cms.femucaribe.go.cr/wp-admin/' } = Astro.props;
---

<section class="portal-section" aria-labelledby="portal-heading">
  <div class="portal-header">
    <span class="portal-kicker">Portal Institucional</span>
    <h1 id="portal-heading" class="portal-title">
      Acceso a Plataformas
    </h1>
    <p class="portal-description">
      Seleccione el perfil de acceso correspondiente para ingresar a los
      servicios federativos y herramientas de gestión de FEMUCARIBE.
    </p>
  </div>

  <!-- Nivel 1: Selección Principal -->
  <div class="portal-grid" role="region" aria-label="Selección de perfil">
    <!-- Card 1: Municipalidades -->
    <article class="portal-card card-municipality">
      <div class="card-badge-row">
        <span class="badge badge-subtle">Gobiernos Locales</span>
        <span class="badge badge-warning">Próximamente</span>
      </div>
      <div class="card-icon-wrapper" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="36"
          height="36"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3" />
        </svg>
      </div>
      <h2 class="card-title">Entrar si eres una municipalidad</h2>
      <p class="card-copy">
        Plataforma intermunicipal exclusiva para alcaldías, concejos municipales
        y departamentos técnicos de los cantones federados del Caribe
        costarricense.
      </p>
      <div class="card-action">
        <button
          type="button"
          class="btn btn-outline"
          id="btn-municipality-info"
          aria-haspopup="dialog"
        >
          <span>Acceso Municipal</span>
          <svg
            viewBox="0 0 20 20"
            width="18"
            height="18"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
              clip-rule="evenodd"
            />
          </svg>
        </button>
      </div>
    </article>

    <!-- Card 2: FEMUCARIBE -->
    <article class="portal-card card-femucaribe" id="card-femucaribe">
      <div class="card-badge-row">
        <span class="badge badge-accent">Equipo Federativo</span>
        <span class="badge badge-positive">Autorizado</span>
      </div>
      <div class="card-icon-wrapper" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="36"
          height="36"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0110 0v4" />
        </svg>
      </div>
      <h2 class="card-title">Entrar si eres de FEMUCARIBE</h2>
      <p class="card-copy">
        Acceso centralizado para funcionarios, personal directivo y
        administradores del portal web de la Federación Municipal del Caribe.
      </p>
      <div class="card-action">
        <button
          type="button"
          class="btn btn-primary"
          id="btn-toggle-femucaribe"
          aria-expanded="false"
          aria-controls="femucaribe-options"
        >
          <span>Ver opciones de FEMUCARIBE</span>
          <svg
            class="chevron-icon"
            viewBox="0 0 20 20"
            width="18"
            height="18"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
              clip-rule="evenodd"
            />
          </svg>
        </button>
      </div>
    </article>
  </div>

  <!-- Nivel 2: Opciones de FEMUCARIBE (Sub-cards) -->
  <div
    class="suboptions-wrapper"
    id="femucaribe-options"
    aria-hidden="true"
    role="region"
    aria-label="Herramientas internas de FEMUCARIBE"
  >
    <div class="suboptions-header">
      <h3 class="suboptions-title">
        <svg
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M9 18l6-6-6-6" />
        </svg>
        <span>Módulos de Gestión de FEMUCARIBE</span>
      </h3>
      <p class="suboptions-subtitle">
        Seleccione el entorno al que desea ingresar:
      </p>
    </div>

    <div class="suboptions-grid">
      <!-- Sub-Card 1: Administración de Landing Page -->
      <div class="subcard subcard-admin">
        <div class="subcard-header">
          <div class="subcard-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="28"
              height="28"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="16" y1="13" x2="8" y2="13" />
              <line x1="16" y1="17" x2="8" y2="17" />
              <polyline points="10 9 9 9 8 9" />
            </svg>
          </div>
          <div>
            <span class="badge badge-accent">Contenido & Transparencia</span>
            <h4 class="subcard-title">Administración de Landing Page</h4>
          </div>
        </div>
        <p class="subcard-description">
          Gestione y cargue documentos oficiales a la nube, administre
          publicaciones de prensa y personalice información de los cantones de
          forma visual y sin código.
        </p>
        <div class="subcard-footer">
          <a
            href={adminUrl}
            class="btn btn-action"
            id="btn-open-login-admin"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Iniciar Sesión Administrativa</span>
            <svg
              viewBox="0 0 20 20"
              width="18"
              height="18"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
        </div>
      </div>

      <!-- Sub-Card 2: Plataforma Web -->
      <div class="subcard subcard-platform">
        <div class="subcard-header">
          <div class="subcard-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="28"
              height="28"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
              <line x1="8" y1="21" x2="16" y2="21" />
              <line x1="12" y1="17" x2="12" y2="21" />
            </svg>
          </div>
          <div>
            <span class="badge badge-warning">En Desarrollo</span>
            <h4 class="subcard-title">Plataforma Web</h4>
          </div>
        </div>
        <p class="subcard-description">
          Sistema integral de expedientes, interoperabilidad y servicios
          digitales para los colaboradores de la Federación Municipal del
          Caribe.
        </p>
        <div class="subcard-footer">
          <button
            type="button"
            class="btn btn-outline"
            id="btn-open-platform-info"
            aria-haspopup="dialog"
          >
            <span>Consultar Plataforma Web</span>
            <svg
              viewBox="0 0 20 20"
              width="18"
              height="18"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal 1: Dialog Municipalidad Info -->
  <dialog
    id="modal-municipality"
    class="portal-dialog"
    aria-labelledby="dialog-muni-title"
  >
    <div class="dialog-content">
      <div class="dialog-header">
        <div class="dialog-icon warning" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
        </div>
        <div>
          <h3 id="dialog-muni-title" class="dialog-title">
            Portal de Gobiernos Locales
          </h3>
          <p class="dialog-subtitle">Estado de integración federativa</p>
        </div>
      </div>
      <p class="dialog-body">
        El portal exclusivo para municipalidades federadas del Caribe se
        encuentra actualmente en fase de integración técnica.
        <br />
        <br />
        Para trámites inmediatos o soporte institucional, por favor comuníquese
        con la Dirección Ejecutiva de FEMUCARIBE al correo{' '}
        <strong>info@femucaribe.go.cr</strong>.
      </p>
      <div class="dialog-actions">
        <button type="button" class="btn btn-primary close-dialog-btn">
          Entendido
        </button>
      </div>
    </div>
  </dialog>

  <!-- Modal 2: Dialog Plataforma Web Info -->
  <dialog
    id="modal-platform"
    class="portal-dialog"
    aria-labelledby="dialog-plat-title"
  >
    <div class="dialog-content">
      <div class="dialog-header">
        <div class="dialog-icon info" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="16" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12.01" y2="8" />
          </svg>
        </div>
        <div>
          <h3 id="dialog-plat-title" class="dialog-title">
            Plataforma Web Institucional
          </h3>
          <p class="dialog-subtitle">Próximo despliegue</p>
        </div>
      </div>
      <p class="dialog-body">
        La Plataforma Web de FEMUCARIBE está programada para su habilitación en
        la siguiente etapa del plan de modernización tecnológica intermunicipal.
      </p>
      <div class="dialog-actions">
        <button type="button" class="btn btn-primary close-dialog-btn">
          Cerrar
        </button>
      </div>
    </div>
  </dialog>
</section>

<script is:inline>
  (() => {
    // 1. Toggle Suboptions FEMUCARIBE
    const toggleBtn = document.getElementById('btn-toggle-femucaribe');
    const suboptions = document.getElementById('femucaribe-options');

    if (toggleBtn && suboptions) {
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
        suboptions.setAttribute('aria-hidden', String(isExpanded));
        suboptions.classList.toggle('is-visible', !isExpanded);

        if (!isExpanded) {
          suboptions.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          const firstAction = suboptions.querySelector('button, a');
          if (firstAction) firstAction.focus();
        }
      });
    }

    // 2. Modals Management
    const muniModal = document.getElementById('modal-municipality');
    const platModal = document.getElementById('modal-platform');

    const btnMuni = document.getElementById('btn-municipality-info');
    const btnPlat = document.getElementById('btn-open-platform-info');

    if (btnMuni && muniModal) {
      btnMuni.addEventListener('click', () => muniModal.showModal());
    }

    if (btnPlat && platModal) {
      btnPlat.addEventListener('click', () => platModal.showModal());
    }

    // Close buttons for dialogs
    document.querySelectorAll('.close-dialog-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const dialog = e.target.closest('dialog');
        if (dialog) dialog.close();
      });
    });

    // Close on backdrop click
    document.querySelectorAll('.portal-dialog').forEach((dialog) => {
      dialog.addEventListener('click', (e) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog =
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width;
        if (!isInDialog) dialog.close();
      });
    });
  })();
</script>

<style>
  .portal-section {
    padding-block: clamp(2rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .portal-header {
    text-align: center;
    max-inline-size: 48rem;
    margin-inline: auto;
  }

  .portal-kicker {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--theme-link);
    margin-block-end: 0.5rem;
  }

  .portal-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--theme-text);
    margin-block: 0 0.75rem;
  }

  .portal-description {
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    color: var(--theme-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Grid Principal */
  .portal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--layout-gap);
  }

  .portal-card {
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: 1rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
    box-shadow: 0 4px 12px rgb(0 0 0 / 4%);
  }

  .portal-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgb(0 0 0 / 8%);
    border-color: var(--theme-border-tint);
  }

  .card-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
  }

  .badge-subtle {
    background: var(--theme-surface-subtle);
    color: var(--theme-text-secondary);
  }

  .badge-warning {
    background: var(--theme-status-warning-bg);
    color: var(--theme-status-warning-text);
  }

  .badge-accent {
    background: var(--theme-surface-accent);
    color: var(--theme-action);
  }

  .badge-positive {
    background: var(--theme-status-positive-bg);
    color: var(--theme-status-positive-text);
  }

  .card-icon-wrapper {
    inline-size: 4rem;
    block-size: 4rem;
    border-radius: 0.75rem;
    background: var(--theme-surface-tint);
    color: var(--theme-link);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-title {
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 700;
    color: var(--theme-text);
    margin: 0;
    line-height: 1.25;
  }

  .card-copy {
    color: var(--theme-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
  }

  .card-action {
    margin-block-start: 0.5rem;
  }

  /* Suboptions FEMUCARIBE */
  .suboptions-wrapper {
    display: none;
    background: var(--theme-surface-muted);
    border: 1px solid var(--theme-border);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    animation: fade-in 0.3s ease-out forwards;
  }

  .suboptions-wrapper.is-visible {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .suboptions-header {
    border-block-end: 1px solid var(--theme-border-subtle);
    padding-block-end: 1rem;
  }

  .suboptions-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--theme-text);
    margin: 0 0 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .suboptions-subtitle {
    color: var(--theme-text-muted);
    font-size: 0.875rem;
    margin: 0;
  }

  .suboptions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--layout-gap);
  }

  .subcard {
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 2px 6px rgb(0 0 0 / 3%);
  }

  .subcard-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .subcard-icon {
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 0.5rem;
    background: var(--theme-surface-accent);
    color: var(--theme-action);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .subcard-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--theme-text);
    margin: 0.25rem 0 0;
  }

  .subcard-description {
    color: var(--theme-text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
    flex-grow: 1;
  }

  .subcard-footer {
    margin-block-start: 0.5rem;
  }

  /* Botones accesibles */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 0.5rem;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
    text-decoration: none;
    inline-size: 100%;
    min-block-size: 2.75rem;
  }

  .btn:focus-visible {
    outline: 2px solid var(--theme-link);
    outline-offset: 2px;
  }

  .btn-primary {
    background: var(--theme-action);
    color: #fff;
    border: 1px solid transparent;
  }

  .btn-primary:hover {
    background: var(--theme-action-hover);
  }

  .btn-action {
    background: #0284c7;
    color: #fff;
    border: 1px solid transparent;
  }

  .btn-action:hover {
    background: #0369a1;
  }

  .btn-outline {
    background: transparent;
    color: var(--theme-text);
    border: 1px solid var(--theme-border);
  }

  .btn-outline:hover {
    background: var(--theme-surface-subtle);
    border-color: var(--theme-border-tint);
  }

  .chevron-icon {
    transition: transform 0.2s ease;
  }

  [aria-expanded='true'] .chevron-icon {
    transform: rotate(180deg);
  }

  /* Dialogs */
  .portal-dialog {
    padding: 0;
    border: none;
    border-radius: 1rem;
    background: transparent;
    max-inline-size: min(90vw, 30rem);
    margin: auto;
    box-shadow: 0 20px 40px rgb(0 0 0 / 25%);
  }

  .portal-dialog::backdrop {
    background: rgb(11 37 56 / 60%);
    backdrop-filter: blur(4px);
  }

  .dialog-content {
    background: var(--theme-surface);
    color: var(--theme-text);
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--theme-border);
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .dialog-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .dialog-icon {
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dialog-icon.warning {
    background: var(--theme-status-warning-bg);
    color: var(--theme-status-warning-text);
  }

  .dialog-icon.info {
    background: var(--theme-surface-accent);
    color: var(--theme-link);
  }

  .dialog-icon.primary {
    background: var(--theme-surface-tint);
    color: var(--theme-action);
  }

  .dialog-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    color: var(--theme-text);
  }

  .dialog-subtitle {
    font-size: 0.8125rem;
    color: var(--theme-text-muted);
    margin: 0;
  }

  .dialog-body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--theme-text-secondary);
    margin: 0;
  }

  .dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }

  .dialog-actions .btn {
    inline-size: auto;
    min-inline-size: 6rem;
  }
</style>
