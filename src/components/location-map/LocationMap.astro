---
// src/components/location-map/LocationMap.astro
interface Props {
  location?: string | undefined;
  coordinates?: string | undefined;
  address?: string | undefined;
  googleMapsUrl?: string | undefined;
  class?: string | undefined;
}

const {
  location = 'Sede Central · Siquirres, Costa Rica',
  coordinates = '10.0985° N, 83.5074° W',
  address = 'Barrio Mangal, contiguo a la estación de bomberos',
  googleMapsUrl = 'https://www.google.com/maps/search/?api=1&query=Federaci%C3%B3n+Municipal+del+Caribe+Costarricense+Siquirres',
  class: className,
} = Astro.props;
---

<div class:list={['location-map-wrapper', className]} data-location-map-wrapper>
  <div
    class="location-map-card is-expanded"
    data-location-map-card
    role="region"
    aria-label={`Ubicación geográfica: ${location}`}
  >
    <!-- Background viewport: Vector grid and schematic road map -->
    <div class="map-viewport" aria-hidden="true">
      <!-- Grid pattern overlay -->
      <svg class="map-grid-pattern" width="100%" height="100%">
        <defs>
          <pattern
            id="loc-grid"
            width="24"
            height="24"
            patternUnits="userSpaceOnUse"
          >
            <path
              d="M 24 0 L 0 0 0 24"
              fill="none"
              class="grid-line"
              stroke-width="0.5"
            ></path>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#loc-grid)"></rect>
      </svg>

      <!-- Schematic street network -->
      <div class="schematic-map">
        <svg class="roads-svg" viewBox="0 0 400 240" preserveAspectRatio="none">
          <!-- Horizontal avenues (Ruta 32 / Eje Siquirres) -->
          <line
            x1="0"
            y1="85"
            x2="400"
            y2="85"
            class="road-arterial road-h1"
            stroke-width="5"
          ></line>
          <line
            x1="0"
            y1="155"
            x2="400"
            y2="155"
            class="road-arterial road-h2"
            stroke-width="4.5"
          ></line>

          <!-- Vertical avenues (Av. Central / Acceso Bomberos) -->
          <line
            x1="130"
            y1="0"
            x2="130"
            y2="240"
            class="road-collector road-v1"
            stroke-width="3.5"
          ></line>
          <line
            x1="270"
            y1="0"
            x2="270"
            y2="240"
            class="road-arterial road-v2"
            stroke-width="4.5"
          ></line>

          <!-- Secondary connecting streets -->
          <line
            x1="0"
            y1="40"
            x2="400"
            y2="40"
            class="road-local"
            stroke-width="1.75"
          ></line>
          <line
            x1="0"
            y1="200"
            x2="400"
            y2="200"
            class="road-local"
            stroke-width="1.75"
          ></line>
          <line
            x1="65"
            y1="0"
            x2="65"
            y2="240"
            class="road-local"
            stroke-width="1.75"
          ></line>
          <line
            x1="200"
            y1="0"
            x2="200"
            y2="240"
            class="road-local"
            stroke-width="1.75"
          ></line>
          <line
            x1="345"
            y1="0"
            x2="345"
            y2="240"
            class="road-local"
            stroke-width="1.75"
          ></line>
        </svg>

        <!-- Building blocks representing civic buildings and surroundings -->
        <div class="building b-1"></div>
        <div class="building b-2"></div>
        <div class="building b-3"></div>
        <div class="building b-4"></div>
        <div class="building b-5"></div>
        <div class="building b-6"></div>

        <!-- Center location pin -->
        <div class="pin-marker" title="Sede Central FEMUCARIBE">
          <div class="pin-pulse" aria-hidden="true"></div>
          <svg
            class="pin-icon"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
              fill="#10b981"
            ></path>
            <circle cx="12" cy="9" r="2.5" fill="#fff"></circle>
          </svg>
        </div>
      </div>

      <!-- Scrim overlay -->
      <div class="scrim-overlay"></div>
    </div>

    <!-- Card Content Layer -->
    <div class="card-content">
      <!-- Top header: Map icon + Sede Central badge -->
      <div class="content-header">
        <div class="map-badge-icon" aria-hidden="true">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
            <line x1="9" y1="3" x2="9" y2="18"></line>
            <line x1="15" y1="6" x2="15" y2="21"></line>
          </svg>
        </div>

        <div class="live-indicator">
          <span class="live-dot" aria-hidden="true"></span>
          <span class="live-text">Sede Central</span>
        </div>
      </div>

      <!-- Bottom footer: Title, Coordinates, and Actions -->
      <div class="content-footer">
        <div class="location-details">
          <h3 class="location-name">{location}</h3>
          {address && <p class="location-address">{address}</p>}
          <p class="location-coords">{coordinates}</p>
          <div class="accent-line" aria-hidden="true"></div>
        </div>

        <div class="card-actions">
          <button
            type="button"
            class="toggle-btn"
            data-toggle-btn
            aria-expanded="true"
            hidden
          >
            <span class="toggle-text-expand">Ver mapa</span>
            <span class="toggle-text-collapse">Ocultar mapa</span>
          </button>
          {googleMapsUrl && (
            <a
              href={googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="directions-btn"
            >
              Cómo llegar <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .location-map-wrapper {
    perspective: 1000px;
    inline-size: 100%;
    margin-block-start: 1.5rem;
  }

  .location-map-card {
    position: relative;
    overflow: hidden;
    inline-size: 100%;
    min-block-size: 11rem;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border-subtle);
    border-radius: 1rem;
    box-shadow: 0 4px 20px -2px rgb(0 0 0 / 8%);
    transform-style: preserve-3d;
    transition:
      min-block-size 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.15s ease-out;
  }

  .location-map-card.is-expanded {
    min-block-size: 21rem;
    border-color: rgb(16 185 129 / 40%);
    box-shadow: 0 12px 32px -4px rgb(16 185 129 / 12%);
  }

  .map-viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .map-grid-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    transition: opacity 0.3s ease;
  }

  .grid-line {
    stroke: var(--theme-text);
  }

  .is-expanded .map-grid-pattern {
    opacity: 0.04;
  }

  /* Schematic map layers */
  .schematic-map {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    transition: opacity 0.4s ease;
  }

  .is-expanded .schematic-map {
    opacity: 1;
  }

  .roads-svg {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .road-arterial {
    stroke: var(--theme-text);
    stroke-opacity: 0.28;
  }

  .road-collector {
    stroke: var(--theme-text);
    stroke-opacity: 0.2;
  }

  .road-local {
    stroke: var(--theme-text);
    stroke-opacity: 0.12;
  }

  /* Building footprints */
  .building {
    position: absolute;
    background: var(--theme-text);
    opacity: 0.08;
    border: 1px solid var(--theme-text);
    border-radius: 0.25rem;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .is-expanded .building {
    opacity: 0.12;
  }

  .b-1 {
    inset-block-start: 18%;
    inset-inline-start: 12%;
    inline-size: 16%;
    block-size: 14%;
  }

  .b-2 {
    inset-block-start: 15%;
    inset-inline-start: 42%;
    inline-size: 18%;
    block-size: 16%;
  }

  .b-3 {
    inset-block-start: 16%;
    inset-inline-end: 10%;
    inline-size: 14%;
    block-size: 24%;
  }

  .b-4 {
    inset-block-start: 56%;
    inset-inline-start: 8%;
    inline-size: 14%;
    block-size: 20%;
  }

  .b-5 {
    inset-block-start: 58%;
    inset-inline-start: 40%;
    inline-size: 20%;
    block-size: 22%;
  }

  .b-6 {
    inset-block-start: 62%;
    inset-inline-end: 12%;
    inline-size: 18%;
    block-size: 18%;
  }

  /* Pin marker */
  .pin-marker {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -100%);
  }

  .pin-icon {
    display: block;
    filter: drop-shadow(0 4px 10px rgb(16 185 129 / 50%));
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .pin-pulse {
    position: absolute;
    inset-block-end: 0;
    inline-size: 2rem;
    block-size: 0.75rem;
    border-radius: 999px;
    background: rgb(16 185 129 / 35%);
    animation: pin-glow 2.5s infinite ease-in-out;
  }

  @keyframes pin-glow {
    0%,
    100% {
      transform: scale(0.85);
      opacity: 0.5;
    }

    50% {
      transform: scale(1.35);
      opacity: 0.15;
    }
  }

  .scrim-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--theme-surface) 90%, transparent) 0%,
      color-mix(in srgb, var(--theme-surface) 55%, transparent) 40%,
      color-mix(in srgb, var(--theme-surface) 95%, transparent) 100%
    );
  }

  /* Card content layer */
  .card-content {
    position: relative;
    z-index: 10;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-block-size: 100%;
    padding: 1.25rem;
  }

  .content-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .map-badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    color: #10b981;
    background: rgb(16 185 129 / 12%);
    border: 1px solid rgb(16 185 129 / 25%);
    border-radius: 0.5rem;
  }

  .live-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.625rem;
    background: var(--theme-surface-tint);
    border: 1px solid var(--theme-border-tint);
    border-radius: 999px;
  }

  .live-dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    background: #10b981;
    border-radius: 999px;
    box-shadow: 0 0 6px rgb(16 185 129 / 80%);
  }

  .live-text {
    color: var(--theme-link);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .content-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 1rem;
  }

  .location-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-inline-size: 0;
  }

  .location-name {
    margin: 0;
    color: var(--theme-text);
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.25;
  }

  .location-address {
    margin: 0;
    color: var(--theme-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .location-coords {
    margin: 0;
    color: var(--theme-text-muted);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
  }

  .accent-line {
    inline-size: 3rem;
    block-size: 2px;
    margin-block-start: 0.25rem;
    background: linear-gradient(90deg, #10b981 0%, transparent 100%);
    border-radius: 1px;
    transition: inline-size 0.4s ease;
  }

  .is-expanded .accent-line {
    inline-size: 100%;
  }

  /* Actions */
  .card-actions {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .toggle-btn,
  .directions-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-block-size: 2.375rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 650;
    border-radius: 0.5rem;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .toggle-btn {
    color: var(--theme-text);
    background: var(--theme-surface-muted);
    border: 1px solid var(--theme-border-subtle);
  }

  .toggle-btn:hover {
    background: var(--theme-surface-subtle);
    border-color: var(--theme-border);
  }

  .toggle-btn .toggle-text-collapse {
    display: none;
  }

  .is-expanded .toggle-btn .toggle-text-expand {
    display: none;
  }

  .is-expanded .toggle-btn .toggle-text-collapse {
    display: inline;
  }

  .directions-btn {
    color: #fff;
    background: #10b981;
    border: 1px solid #10b981;
  }

  .directions-btn:hover {
    color: #fff;
    background: #059669;
    border-color: #059669;
  }

  .toggle-btn:focus-visible,
  .directions-btn:focus-visible {
    outline: 2px solid var(--theme-focus-ring);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .location-map-card,
    .schematic-map,
    .accent-line,
    .pin-pulse {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  function initLocationMap() {
    const cards = document.querySelectorAll<HTMLElement>(
      '[data-location-map-card]',
    );

    cards.forEach((card) => {
      const toggleBtn =
        card.querySelector<HTMLButtonElement>('[data-toggle-btn]');

      if (toggleBtn) {
        toggleBtn.hidden = false;
      }

      const toggleExpand = () => {
        const isCurrentlyExpanded = card.classList.contains('is-expanded');
        const nextState = !isCurrentlyExpanded;
        card.classList.toggle('is-expanded', nextState);
        if (toggleBtn) {
          toggleBtn.setAttribute('aria-expanded', String(nextState));
        }
      };

      if (toggleBtn) {
        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleExpand();
        });
      }

      // Smooth 3D Tilt interaction on fine pointer (mouse)
      const isFinePointer = window.matchMedia('(pointer: fine)').matches;
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      if (isFinePointer && !prefersReducedMotion) {
        let isHovered = false;

        card.addEventListener('pointerenter', () => {
          isHovered = true;
        });

        card.addEventListener('pointermove', (e) => {
          if (!isHovered) return;
          const rect = card.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;
          const deltaX = (e.clientX - centerX) / (rect.width / 2);
          const deltaY = (e.clientY - centerY) / (rect.height / 2);

          const rotX = Math.max(-8, Math.min(8, deltaY * -8));
          const rotY = Math.max(-8, Math.min(8, deltaX * 8));

          card.style.transform = `perspective(1000px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg)`;
        });

        card.addEventListener('pointerleave', () => {
          isHovered = false;
          card.style.transform =
            'perspective(1000px) rotateX(0deg) rotateY(0deg)';
        });
      }
    });
  }

  // Initialize on page load and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLocationMap, {
      once: true,
    });
  } else {
    initLocationMap();
  }
  document.addEventListener('astro:page-load', initLocationMap);
</script>
