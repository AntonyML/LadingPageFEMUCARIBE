---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const transparencyUrl = `${base}/transparencia`;
---

<section class="home-transparency-banner" aria-labelledby="transparency-title">
  <div class="content">
    <h2 class="title" id="transparency-title">
      Portal de Transparencia Activa y Rendición de Cuentas
    </h2>
    <p class="description">
      Consulte en línea presupuestos, actas de asamblea y consejo, compras en
      SICOP y preguntas frecuentes normativas.
    </p>
  </div>
  <a class="link" href={transparencyUrl}>
    Ver Transparencia (05)
    <span aria-hidden="true">→</span>
  </a>
</section>

<style>
  .home-transparency-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-inline-size: 0;
    min-block-size: 7.5rem;
    padding: 1.125rem 2rem;
    margin-block-end: 1.75rem;
    background: var(--theme-surface-tint);
    border: 1px solid var(--theme-border-tint);
    border-radius: 0.875rem;
  }

  .content {
    display: flex;
    flex: 0 1 55rem;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    min-inline-size: 0;
    min-block-size: 4rem;
  }

  .title {
    margin: 0;
    color: var(--theme-text);
    font-size: 1.0313rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .description {
    margin: 0;
    color: var(--theme-text-secondary);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .link {
    display: inline-flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-items: center;
    justify-content: center;
    min-inline-size: 11.875rem;
    min-block-size: 2.75rem;
    padding: 0.6875rem 1.25rem;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    background: var(--theme-action);
    border-radius: 0.5rem;
  }

  .link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (width <= 48rem) {
    .home-transparency-banner {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1rem;
    }

    .content {
      flex-basis: auto;
      min-block-size: 0;
    }

    .title {
      font-size: 1rem;
    }

    .description {
      font-size: 0.875rem;
      line-height: 1.45;
    }

    .link {
      align-self: flex-start;
      min-inline-size: 0;
      max-inline-size: 100%;
    }
  }
</style>
