---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const manualUrl = `${base}/manual-de-usuario`;
---

<section class="home-manual-cta" aria-labelledby="home-manual-title">
  <div class="card">
    <div class="copy">
      <h2 id="home-manual-title" class="title">
        Manual de usuario
      </h2>
      <p class="description">
        Consulte la guía para navegar el sitio como visitante o para administrar
        contenidos desde el CMS según su rol.
      </p>
    </div>
    <a class="link" href={manualUrl}>
      Ver manual de usuario <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .home-manual-cta {
    min-inline-size: 0;
    margin-block: 0 1.875rem;
  }

  .card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    min-inline-size: 0;
    min-block-size: 4.25rem;
    padding: 0.875rem 1.25rem;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: 0.5rem;
  }

  .copy {
    display: flex;
    flex: 1 1 24rem;
    flex-direction: column;
    gap: 0.25rem;
    min-inline-size: 0;
  }

  .title {
    margin: 0;
    font-size: clamp(0.9375rem, 0.875rem + 0.25vw, 1.0625rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--theme-text);
  }

  .description {
    margin: 0;
    font-size: clamp(0.8125rem, 0.775rem + 0.15vw, 0.9375rem);
    font-weight: 400;
    line-height: 1.45;
    color: var(--theme-text-muted);
    overflow-wrap: break-word;
  }

  .link {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--theme-border-tint);
    border-radius: 0.5rem;
    background: var(--theme-surface-tint);
    color: var(--theme-link);
    font-size: clamp(0.8125rem, 0.775rem + 0.15vw, 0.875rem);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  .link:hover {
    background: var(--theme-surface-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
