---
import logo from '../assets/brand/femucaribe.png';

interface Props {
  currentPath?: string;
  platformUrl?: string;
}

const { currentPath = Astro.url.pathname, platformUrl } = Astro.props;
if (platformUrl !== undefined) {
  try {
    const url = new URL(platformUrl);
    if (
      platformUrl !== platformUrl.trim() ||
      !['http:', 'https:'].includes(url.protocol)
    )
      throw new Error();
  } catch {
    throw new Error('PublicNavbar platformUrl must be an HTTP(S) URL');
  }
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { label: 'Inicio', path: '/' },
  { label: 'Nosotros', path: '/nosotros' },
  { label: 'Municipalidades', path: '/municipalidades' },
  { label: 'Proyectos', path: '/proyectos' },
  { label: 'Transparencia', path: '/transparencia' },
  { label: 'Noticias', path: '/noticias' },
];
const activePath = currentPath.replace(/\/$/, '') || '/';
const href = (path: string) => `${base}${path}`;
---

<nav class="public-navbar" aria-label="Navegación principal">
  <div class="navbar-container site-container">
    <div class="navbar-content">
      <a class="brand" href={href('/')} aria-label="FEMUCARIBE, Inicio">
        <img src={logo.src} width="55" height="70" alt="" />
        <span class="brand-copy">
          <span class="brand-title">FEMUCARIBE</span>
          <span class="brand-subtitle">
            Federación Municipal del Caribe Costarricense y Asociados
          </span>
        </span>
      </a>
      <ul class="links">
        {links.map(({ label, path }) => (
          <li>
            <a
              href={href(path)}
              aria-current={
                activePath === (href(path).replace(/\/$/, '') || '/')
                  ? 'page'
                  : undefined
              }
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <div class="actions">
        <a class="contact" href={href('/contacto')}>
          Contáctenos
        </a>
        {platformUrl ? (
          <a class="platform" href={platformUrl}>
            Acceder a la plataforma
          </a>
        ) : (
          <span class="platform" aria-disabled="true">
            Acceder a la plataforma
          </span>
        )}
      </div>
    </div>
  </div>
</nav>

<style>
  .public-navbar {
    box-shadow: inset 0 0 0 1px #e2e8f0;
    background: #fff;
    font-family: 'FEMUCARIBE Inter', sans-serif;
  }

  .navbar-container {
    container: public-navigation / inline-size;
  }

  .navbar-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'brand' 'links' 'actions';
    align-items: center;
    gap: 12px 16px;
    min-block-size: 72px;
    padding-block: 12px;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: #435362;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:focus-visible {
    outline: 2px solid #0470a0;
    outline-offset: 3px;
    border-radius: 3px;
  }

  a[aria-current='page'] {
    color: #0470a0;
    font-weight: 800;
  }

  .brand {
    grid-area: brand;
    min-inline-size: 0;
    gap: 10px;
    color: #0470a0;
    justify-self: start;
  }

  .brand img {
    flex: 0 0 55px;
    object-fit: cover;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }

  .brand-title {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .brand-subtitle {
    font-size: 10px;
    font-weight: 700;
  }

  .links {
    grid-area: links;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    min-inline-size: 0;
  }

  .contact,
  .platform {
    display: inline-flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    min-inline-size: 0;
    min-block-size: 44px;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 700;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .contact {
    background: #0470a0;
    color: #fff;
  }

  .platform {
    border: 3px solid #0470a0;
    color: #0470a0;
  }

  @container public-navigation (width >= 700px) {
    .navbar-content {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'brand brand' 'links actions';
    }

    .brand-title {
      font-size: 36px;
      letter-spacing: 4.5px;
    }

    .brand-subtitle {
      font-size: 10.5px;
      letter-spacing: -0.5px;
    }

    .actions {
      flex-wrap: nowrap;
      justify-self: end;
    }

    .contact {
      flex: 0 0 auto;
      min-inline-size: 120px;
    }

    .platform {
      flex: 0 0 auto;
      min-inline-size: 171px;
    }
  }

  @container public-navigation (width >= 1200px) {
    .navbar-content {
      grid-template-columns: minmax(0, 347px) minmax(0, 1fr) auto;
      grid-template-areas: 'brand links actions';
      padding-block: 0;
    }

    .links {
      justify-content: center;
    }

    .links a {
      min-block-size: 24px;
    }

    .contact,
    .platform {
      min-block-size: 38px;
    }
  }

  @container public-navigation (width >= 1260px) {
    .links {
      column-gap: 24px;
    }
  }
</style>
