---
import AuthoritySummary from './AuthoritySummary.astro';
import CantonTerritories from './CantonTerritories.astro';
import MunicipalityOverview from './MunicipalityOverview.astro';
import MunicipalityProfiles from './MunicipalityProfiles.astro';
import TechnicalLiaison from './TechnicalLiaison.astro';
import styles from './page.module.css';
import type { MunicipalGovernment } from './types';

interface Props {
  municipalities: readonly MunicipalGovernment[];
}
const { municipalities } = Astro.props;
---

<div class={styles.page}>
  <MunicipalityOverview municipalities={municipalities} />
  <TechnicalLiaison />
  <MunicipalityProfiles municipalities={municipalities} />
  <AuthoritySummary municipalities={municipalities} />
  <CantonTerritories municipalities={municipalities} />
</div>
