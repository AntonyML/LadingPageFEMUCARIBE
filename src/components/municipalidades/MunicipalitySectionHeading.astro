---
import styles from './page.module.css';

interface Props {
  id: string;
  label: string;
  title: string;
  description: string;
  class?: string | undefined;
}

const { id, label, title, description, class: className } = Astro.props;
---

<header class:list={[styles['section-header'], className]}>
  <p class={styles['section-label']}>{label}</p>
  <h2 class={styles['section-title']} id={id}>
    {title}
  </h2>
  <p class={styles['section-description']}>{description}</p>
</header>
