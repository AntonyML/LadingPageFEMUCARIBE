---
// src/components/proyectos/ProjectsFederation.astro

interface ProjectItem {
  category: string;
  title: string;
  description: string;
  status: string;
  accentColor: string;
  statusBg: string;
  statusColor: string;
}

const federationProjects: readonly ProjectItem[] = [
  {
    category: 'Formulación y Ejecución',
    title: 'Unidad Gestora de Proyectos (UGP)',
    description:
      'Estructura técnica especializada de FEMUCARIBE encargada de formular la cartera de proyectos de inversión pública regional, gestionar fuentes de financiamiento y fiscalizar su ejecución conforme a la normativa de contratación pública.',
    status: 'En ejecución',
    accentColor: '#10b981',
    statusBg: 'var(--theme-status-positive-bg)',
    statusColor: 'var(--theme-status-positive-text)',
  },
  {
    category: 'Movilidad Eléctrica y Energía',
    title: 'Electrolinera',
    description:
      'Centro de carga rápida para transporte liviano y comercial en el corredor Atlántico, reduciendo emisiones de carbono e impulsando la descarbonización del sector transporte.',
    status: 'En operación',
    accentColor: '#aac651',
    statusBg: 'var(--theme-status-positive-bg)',
    statusColor: 'var(--theme-status-positive-text)',
  },
  {
    category: 'Innovación y Conocimiento',
    title: 'Parque Tecnológico y Productivo',
    description:
      'Plataforma para incubación de empresas de base tecnológica, transferencia técnica y capacitación orientada a jóvenes de la provincia de Limón.',
    status: 'En formulación',
    accentColor: '#1dc4da',
    statusBg: 'var(--theme-surface-accent)',
    statusColor: 'var(--theme-link)',
  },
  {
    category: 'Gestión Ambiental y Circular',
    title: 'Planta Recicladora',
    description:
      'Infraestructura de valorización de residuos sólidos urbanos con enfoque de economía circular, apoyando a las municipalidades en el cumplimiento de la Ley 8839.',
    status: 'En operación',
    accentColor: '#aac651',
    statusBg: 'var(--theme-status-positive-bg)',
    statusColor: 'var(--theme-status-positive-text)',
  },
];
---

<section
  class="projects-federation"
  aria-labelledby="projects-federation-title"
>
  <h2 id="projects-federation-title" class="section-title">
    Proyectos Propios de FEMUCARIBE
  </h2>

  <ul class="projects-grid" role="list">
    {federationProjects.map(
      ({
        category,
        title,
        description,
        status,
        accentColor,
        statusBg,
        statusColor,
      }) => (
        <li class="project-item">
          <article class="card">
            <span
              class="stripe"
              style={`background-color: ${accentColor};`}
              aria-hidden="true"
            />
            <div class="meta-row">
              <div
                class="icon-wrapper"
                style={`background-color: ${statusBg}; color: ${statusColor};`}
                aria-hidden="true"
              >
                <svg
                  class="icon"
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M12 2L2 7L12 12L22 7L12 2ZM2 17L12 22L22 17"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>
              <span
                class="status-badge"
                style={`background-color: ${statusBg}; color: ${statusColor};`}
              >
                {status}
              </span>
            </div>
            <div class="header-group">
              <span class="category">{category}</span>
              <h3 class="card-title">{title}</h3>
            </div>
            <div class="desc-box">
              <p class="description">{description}</p>
            </div>
          </article>
        </li>
      ),
    )}
  </ul>
</section>

<style>
  .projects-federation {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block-end: 2rem;
  }

  .section-title {
    margin: 0;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 1.25rem; /* 20px */
    font-weight: 800;
    line-height: 1.2;
    color: var(--theme-text);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 75rem) {
    .projects-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .project-item {
    display: flex;
  }

  .card {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    position: relative;
    background-color: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: 0.75rem; /* 12px */
    padding: 1rem;
    box-sizing: border-box;
    min-block-size: 23.75rem; /* 380px */
  }

  .stripe {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline: 1rem;
    block-size: 3px;
    border-radius: 1.5px;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block: 1.625rem 1rem; /* Space below stripe */
  }

  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.125rem; /* 34px */
    block-size: 2.125rem;
    border-radius: 50%;
  }

  .status-badge {
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.6563rem; /* 10.5px */
    font-weight: 700;
    padding: 0.25rem 0.625rem;
    border-radius: 0.6875rem; /* 11px */
    line-height: 1.2;
  }

  .header-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-block-end: 1rem;
  }

  .category {
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.625rem; /* 10px */
    font-weight: 600;
    color: var(--theme-link);
    line-height: 1.2;
    text-transform: uppercase;
  }

  .card-title {
    margin: 0;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.9063rem; /* 14.5px */
    font-weight: 800;
    line-height: 1.3;
    color: var(--theme-text);
  }

  .desc-box {
    background-color: var(--theme-surface-muted);
    border-radius: 0.5rem; /* 8px */
    padding: 0.875rem 1rem;
    flex-grow: 1;
    display: flex;
    align-items: flex-start;
  }

  .description {
    margin: 0;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.7188rem; /* 11.5px */
    font-weight: 400;
    line-height: 1.45;
    color: var(--theme-text-secondary);
  }

  @media (width <= 48rem) {
    .card {
      min-block-size: auto;
    }

    .category {
      font-size: 0.75rem;
    }

    .card-title {
      font-size: 1.0625rem;
    }

    .description {
      font-size: 0.875rem;
    }

    .status-badge {
      font-size: 0.75rem;
    }
  }
</style>
