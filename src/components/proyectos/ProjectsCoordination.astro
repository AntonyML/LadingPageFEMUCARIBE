---
// src/components/proyectos/ProjectsCoordination.astro
import { fetchPipelineProjects } from '../../lib/cms-projects';

const pipelineMunicipalities = await fetchPipelineProjects();
---

<section
  class="projects-coordination"
  aria-labelledby="projects-coordination-title"
>
  <h2 id="projects-coordination-title" class="section-title">
    Proyectos en Coordinación con Gobiernos Locales
  </h2>

  <div class="active-management-card">
    <div class="card-header">
      <h3 class="active-title">
        Municipalidad de Talamanca · 2 proyectos en gestión activa
      </h3>
      <span class="status-badge-active">En gestión</span>
    </div>

    <div class="subprojects-grid">
      <article class="subproject-box">
        <h4 class="subproject-title">
          1. Mojones Fronterizos Costa Rica – Panamá (Sixaola)
        </h4>
        <p class="subproject-desc">
          Demarcación territorial e infraestructura fronteriza en el paso
          Sixaola, garantizando soberanía, ordenamiento y seguridad para el
          comercio binacional.
        </p>
      </article>

      <article class="subproject-box">
        <h4 class="subproject-title">
          2. Infraestructura Deportiva y Recreativa (Bribri)
        </h4>
        <p class="subproject-desc">
          Complejo comunal deportivo y espacios públicos en Bribri para el
          fomento de la salud, recreación juvenil e integración comunitaria en
          el Caribe Sur.
        </p>
      </article>
    </div>
  </div>

  <ul class="pipeline-list" role="list">
    {pipelineMunicipalities.map(({ name, status, projects }) => (
      <li class="pipeline-card">
        <div class="pipeline-header">
          <h3 class="municipality-name">{name}</h3>
          <span class="status-badge-pipeline">{status}</span>
        </div>
        {projects && projects.length > 0 && (
          <div class="subprojects-grid">
            {projects.map((proj) => (
              <article class="subproject-box">
                <h4 class="subproject-title">{proj.title}</h4>
                <p class="subproject-desc">{proj.description}</p>
              </article>
            ))}
          </div>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .projects-coordination {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block-end: 2.5rem;
  }

  .section-title {
    margin: 0;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 1.25rem; /* 20px */
    font-weight: 800;
    line-height: 1.2;
    color: var(--theme-text);
  }

  .active-management-card,
  .pipeline-card {
    background-color: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: 0.75rem; /* 12px */
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-header,
  .pipeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .active-title,
  .municipality-name {
    margin: 0;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 1rem; /* 16px */
    font-weight: 800;
    line-height: 1.25;
    color: var(--theme-text);
  }

  .status-badge-active {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.75rem;
    background-color: var(--theme-status-warning-bg);
    color: var(--theme-status-warning-text);
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.6563rem; /* 10.5px */
    font-weight: 700;
    border-radius: 0.75rem; /* 12px */
    line-height: 1.2;
  }

  .subprojects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (width >= 48rem) {
    .subprojects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .subproject-box {
    background-color: var(--theme-surface-muted);
    border-radius: 0.5rem; /* 8px */
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .subproject-title {
    margin: 0;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.8438rem; /* 13.5px */
    font-weight: 700;
    line-height: 1.3;
    color: var(--theme-text);
  }

  .subproject-desc {
    margin: 0;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.7188rem; /* 11.5px */
    font-weight: 400;
    line-height: 1.45;
    color: var(--theme-text-secondary);
  }

  .pipeline-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .status-badge-pipeline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.75rem;
    background-color: var(--theme-surface-subtle);
    color: var(--theme-text-muted);
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.625rem; /* 10px */
    font-weight: 600;
    border-radius: 0.75rem; /* 12px */
    line-height: 1.2;
    white-space: nowrap;
  }

  @media (width <= 48rem) {
    .active-title,
    .municipality-name {
      font-size: 1rem;
    }

    .subproject-title {
      font-size: 0.9375rem;
    }

    .subproject-desc {
      font-size: 0.875rem;
    }

    .status-badge-pipeline {
      font-size: 0.75rem;
    }

    .pipeline-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
