---
// src/components/proyectos/ProjectsCoordination.astro
import { fetchCmsMunicipalities } from '../../lib/cms-municipalities';
import {
  fetchMunicipalPortfolios,
  municipalityProjectsAnchor,
  projectAnchor,
} from '../../lib/cms-projects';

const municipalities = await fetchCmsMunicipalities();
const portfolios = await fetchMunicipalPortfolios(
  municipalities.map(({ id }) => id),
);
const names = new Map(municipalities.map(({ id, name }) => [id, name]));

const countLabel = (count: number) =>
  count === 1 ? '1 proyecto vinculado' : `${count} proyectos vinculados`;
---

<section
  class="projects-coordination"
  aria-labelledby="projects-coordination-title"
>
  <h2 id="projects-coordination-title" class="section-title">
    Proyectos en Coordinación con Gobiernos Locales
  </h2>
  <p class="section-lead">
    Proyectos que FEMUCARIBE ejecuta o acompaña junto a cada municipalidad
    federada.
  </p>

  <ul class="portfolio-list" role="list">
    {portfolios.map(({ municipalityId, projects }) => {
      const name = names.get(municipalityId) ?? municipalityId;
      const headingId = `${municipalityProjectsAnchor(municipalityId)}-title`;
      return (
        <li
          class="portfolio-card"
          id={municipalityProjectsAnchor(municipalityId)}
        >
          <div class="portfolio-header">
            <h3 class="municipality-name" id={headingId}>
              {name}
            </h3>
            <span
              class:list={[
                'count-badge',
                { 'count-badge-active': projects.length > 0 },
              ]}
            >
              {countLabel(projects.length)}
            </span>
          </div>

          {projects.length > 0 ? (
            <ol class="subprojects-grid" role="list">
              {projects.map((project) => (
                <li>
                  <article class="subproject-box">
                    <h4 class="subproject-title">{project.title}</h4>
                    <p class="subproject-desc">{project.description}</p>
                    <div class="subproject-meta">
                      {project.status && (
                        <span class="status-badge">{project.status}</span>
                      )}
                      {project.type !== 'municipal' && (
                        <a
                          class="subproject-link"
                          href={`#${projectAnchor(project.slug)}`}
                        >
                          Ver ficha del proyecto
                          <span class="visually-hidden"> {project.title}</span>
                          <span aria-hidden="true">→</span>
                        </a>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          ) : (
            <p class="empty-state">
              FEMUCARIBE aún no registra proyectos vinculados con esta
              municipalidad. Consulte los{' '}
              <a href="#proyectos-federacion">
                proyectos propios de la Federación
              </a>
              , que benefician a todos los cantones miembros.
            </p>
          )}
        </li>
      );
    })}
  </ul>
</section>

<style>
  .projects-coordination {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block-end: 2.5rem;
  }

  .section-title {
    margin: 0;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 1.25rem; /* 20px */
    font-weight: 800;
    line-height: 1.2;
    color: var(--theme-text);
  }

  .section-lead {
    margin: -0.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--theme-text-secondary);
  }

  .portfolio-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .portfolio-card {
    scroll-margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background-color: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: 0.75rem; /* 12px */
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .portfolio-card:target {
    border-color: var(--theme-action);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--theme-action) 35%, transparent);
  }

  .portfolio-header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .municipality-name {
    margin: 0;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 1rem; /* 16px */
    font-weight: 800;
    line-height: 1.25;
    color: var(--theme-text);
  }

  .count-badge,
  .status-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.75rem;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.6563rem; /* 10.5px */
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    border-radius: 0.75rem; /* 12px */
  }

  .count-badge {
    color: var(--theme-text-muted);
    background-color: var(--theme-surface-subtle);
  }

  .count-badge-active {
    color: var(--theme-status-warning-text);
    background-color: var(--theme-status-warning-bg);
  }

  .status-badge {
    color: var(--theme-link);
    background-color: var(--theme-surface-accent);
  }

  .subprojects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
    counter-reset: subproject;
  }

  @media (width >= 48rem) {
    .subprojects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .subprojects-grid > li {
    display: flex;
  }

  .subproject-box {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    background-color: var(--theme-surface-muted);
    border-radius: 0.5rem; /* 8px */
  }

  .subproject-title {
    counter-increment: subproject;
    margin: 0;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.8438rem; /* 13.5px */
    font-weight: 700;
    line-height: 1.3;
    color: var(--theme-text);
  }

  .subproject-title::before {
    content: counter(subproject) '. ';
  }

  .subproject-desc {
    flex-grow: 1;
    margin: 0;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.7188rem; /* 11.5px */
    font-weight: 400;
    line-height: 1.45;
    color: var(--theme-text-secondary);
  }

  .subproject-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .subproject-link,
  .empty-state a {
    font-weight: 600;
    color: var(--theme-link);
  }

  .subproject-link {
    font-size: 0.75rem;
    text-decoration: none;
  }

  .subproject-link:hover,
  .subproject-link:focus-visible {
    text-decoration: underline;
  }

  .empty-state {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--theme-text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-card {
      transition: none;
    }
  }

  @media (width <= 48rem) {
    .portfolio-header {
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }

    .subproject-title {
      font-size: 0.9375rem;
    }

    .subproject-desc {
      font-size: 0.875rem;
    }

    .count-badge,
    .status-badge,
    .subproject-link {
      font-size: 0.75rem;
    }
  }
</style>
