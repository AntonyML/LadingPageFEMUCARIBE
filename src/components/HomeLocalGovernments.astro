---
interface Props {
  directoryUrl?: string;
}

const { directoryUrl = '/municipalidades' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function href(url: string) {
  if (url !== url.trim() || url.includes('\\')) {
    throw new Error(
      'HomeLocalGovernments destinations must be site-root paths or HTTP(S) URLs',
    );
  }
  if (/^\/(?!\/)/.test(url)) return `${base}${url}`;
  const parsed = new URL(url);
  if (!['http:', 'https:'].includes(parsed.protocol)) {
    throw new Error(
      'HomeLocalGovernments destinations must be site-root paths or HTTP(S) URLs',
    );
  }
  return url;
}

const cantons = [
  { name: 'Limón', role: 'Municipalidad' },
  { name: 'Talamanca', role: 'Municipalidad' },
  { name: 'Matina', role: 'Municipalidad' },
  { name: 'Guácimo', role: 'Municipalidad' },
  { name: 'Pococí', role: 'Municipalidad' },
  { name: 'Parrita', role: 'Municipalidad' },
] as const;
---

<section
  class="home-local-governments"
  aria-labelledby="local-governments-title"
>
  <div class="header">
    <h2 id="local-governments-title" class="title">
      Directorio de Gobiernos Locales Miembro
    </h2>
    <a class="directory-link" href={href(directoryUrl)}>
      Ver directorio detallado (03 · Municipalidades)
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <ul class="cantons-list">
    {cantons.map(({ name, role }) => (
      <li class="canton-item">
        <div class="card">
          <svg
            class="icon"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M12 2L2 7L12 12L22 7L12 2ZM2 17L12 22L22 17"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <h3 class="name">{name}</h3>
          <span class="role">{role}</span>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .home-local-governments {
    padding: 1.25rem 1.5rem;
    margin-block: 0.1875rem 1.875rem;
    background: var(--theme-surface-muted);
    border: 1px solid var(--theme-border);
    border-radius: 0.875rem;
  }

  .header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-block-size: 2.75rem;
    margin-block-end: 1rem;
  }

  .title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--theme-text);
  }

  .directory-link {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    min-block-size: 2.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--theme-link);
    text-decoration: none;
  }

  .directory-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .directory-link:focus-visible {
    outline: 2px solid var(--theme-link);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .cantons-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .canton-item {
    min-inline-size: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    block-size: 100%;
    min-block-size: 7.5rem;
    padding: 1rem 0.5rem;
    text-align: center;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: 0.625rem;
  }

  .icon {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    margin-block-end: 0.5rem;
    color: var(--theme-link);
  }

  .name {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--theme-text);
    overflow-wrap: break-word;
  }

  .role {
    margin-block-start: 0.25rem;
    font-size: 0.625rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--theme-text-muted);
  }

  @media (width <= 23rem) {
    .cantons-list {
      grid-template-columns: 1fr;
    }
  }

  @media (width >= 36rem) {
    .cantons-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .cantons-list {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1.125rem;
    }
  }

  @supports (container-type: inline-size) {
    .home-local-governments {
      container-type: inline-size;
    }

    @container (max-width: 22rem) {
      .cantons-list {
        grid-template-columns: 1fr;
      }
    }

    @container (min-width: 36rem) {
      .cantons-list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @container (min-width: 58rem) {
      .cantons-list {
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 1.125rem;
      }
    }
  }
</style>
