---
import SiteIcon from '../SiteIcon.astro';
---

<label class="theme-preference">
  <SiteIcon name="sun" size={16} />
  <span>Apariencia</span>
  <select data-theme-select aria-label="Tema de color">
    <option value="system">Sistema</option>
    <option value="light">Claro</option>
    <option value="dark">Oscuro</option>
  </select>
</label>

<style>
  .theme-preference {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-block-size: 44px;
    min-inline-size: 0;
    color: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .theme-preference select {
    min-block-size: 44px;
    max-inline-size: 100%;
    padding-inline: 0.4rem;
    border: 1px solid currentcolor;
    border-radius: 6px;
    color: inherit;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .theme-preference select:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }
</style>
