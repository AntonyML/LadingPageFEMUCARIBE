---
import SiteIcon from '../SiteIcon.astro';
import {
  fetchTransparencyDocuments,
  type DocumentItem,
} from '../../lib/cms-transparency';

/**
 * TransparencyDocuments.astro
 * Official downloadable documents and audit reports section.
 * Corresponds to Penpot board L1-Documentos-Descargas (1158a0fe-c558-80da-8008-9409f2dfc5da).
 */

const documents: readonly DocumentItem[] = await fetchTransparencyDocuments();
---

<section
  class="documents-section"
  id="documentos-descargas"
  aria-labelledby="documents-title"
>
  <h2 class="section-title" id="documents-title">
    Presupuestos Auditados, Liquidaciones y Actas Oficiales
  </h2>

  <div class="documents-grid-container">
    <div class="documents-grid">
      {documents.map((doc) => (
        <article class="doc-card" id={doc.id}>
          <div class="doc-header">
            <span class="doc-icon" aria-hidden="true">
              <SiteIcon name="document" size={24} />
            </span>
            <span class="doc-tag">{doc.tag}</span>
            <h3 class="doc-title">{doc.title}</h3>
          </div>

          <div class="doc-footer">
            <span class="doc-meta">{doc.meta}</span>
            <a
              class="doc-download-link"
              href={doc.url && doc.url !== '#' ? doc.url : `#${doc.id}`}
              target={doc.url && doc.url !== '#' ? '_blank' : undefined}
              rel={
                doc.url && doc.url !== '#' ? 'noopener noreferrer' : undefined
              }
              aria-label={`Descargar documento: ${doc.title} (${doc.meta})${doc.url && doc.url !== '#' ? '' : ' - En custodia institucional'}`}
            >
              Descargar documento
              <span class="download-icon" aria-hidden="true">
                <SiteIcon name="download" size={16} />
              </span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .documents-section {
    margin-block-end: 2rem;
  }

  .section-title {
    margin: 0;
    margin-block-end: 1.25rem;
    color: var(--theme-text);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .documents-grid-container {
    container-type: inline-size;
  }

  .documents-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .doc-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-inline-size: 0;
    padding: 1.25rem;
    background-color: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: 0.75rem;
    box-shadow: 0 1px 3px rgb(11 37 56 / 4%);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .doc-card:hover {
    border-color: var(--theme-border-subtle);
    box-shadow: 0 4px 6px -1px rgb(11 37 56 / 8%);
  }

  .doc-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-block-end: 1rem;
  }

  .doc-icon {
    display: inline-flex;
    color: var(--theme-link);
    line-height: 1;
  }

  .doc-tag {
    color: var(--theme-link);
    font-size: 0.6563rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .doc-title {
    margin: 0;
    color: var(--theme-text);
    font-size: 0.9063rem;
    font-weight: 800;
    line-height: 1.35;
  }

  .doc-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-block-start: auto;
  }

  .doc-meta {
    color: var(--theme-text-muted);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .doc-download-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    inline-size: 100%;
    min-block-size: 2.75rem;
    padding-inline: 0.75rem;
    color: var(--theme-link);
    font-size: 0.7188rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    background-color: var(--theme-surface-subtle);
    border: 1px solid transparent;
    border-radius: 0.375rem;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .doc-download-link:hover {
    color: var(--theme-link);
    background-color: var(--theme-surface-subtle);
  }

  .doc-download-link:focus-visible {
    outline: 2px solid var(--theme-link);
    outline-offset: 2px;
  }

  .download-icon {
    display: inline-flex;
    line-height: 1;
  }

  @container (max-width: 64rem) {
    .documents-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @container (max-width: 36rem) {
    .documents-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (width <= 64rem) {
    .documents-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width <= 36rem) {
    .documents-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
