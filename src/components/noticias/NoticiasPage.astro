---
import { fetchNewsArticles } from '../../lib/cms-news';
import NoticiasHeader from './NoticiasHeader.astro';
import NoticiasGrid from './NoticiasGrid.astro';
import NewslettersBanner from './NewslettersBanner.astro';
import styles from './styles.module.css';

const articles = await fetchNewsArticles();
---

<div class={styles.page}>
  <NoticiasHeader />
  <NoticiasGrid articles={articles} />
  <NewslettersBanner />
</div>
