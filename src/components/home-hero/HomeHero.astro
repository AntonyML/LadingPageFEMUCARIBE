const [initialSlide, ...remainingSlides] = slides;
---

<section class:list={['home-hero', styles.hero]} aria-labelledby="hero-title">
  <div class={styles.decoration} aria-hidden="true">
    <span class={styles.diamond}></span>
    <span class={styles.dots}></span>
    <span class={styles.ribbons}></span>
  </div>
  <div class:list={['site-container', styles.composition]}>
    <div class={styles.introduction}>
      <p class={styles.eyebrow}>
        {cms.hero_eyebrow ?? 'Portal institucional oficial'}
      </p>
      <h1 id="hero-title">
        {cms.hero_title ?? 'Impulsamos el desarrollo integral y sostenible'}
      </h1>
      <p class={styles.description}>
        {cms.hero_description ??
          'Unimos esfuerzos municipales para transformar territorios, impulsar la inversión pública y generar oportunidades de desarrollo.'}
      </p>
      <form
        role="search"
        aria-label="Buscar en FEMUCARIBE"
        class={styles.search}
        action={href('/proyectos')}
        method="get"
      >
        <label for="hero-search" class="visually-hidden">
          Buscar en FEMUCARIBE
        </label>
        <fieldset aria-describedby="hero-search-status">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" />
            <path d="m15 15 5 5" stroke="currentColor" stroke-width="2" />
          </svg>
          <input
            id="hero-search"
            name="q"
            type="search"
            placeholder="Buscar acuerdos, proyectos, trámites o cantones..."
            aria-describedby="hero-search-status"
            aria-autocomplete="list"
            aria-controls="hero-search-results"
            autocomplete="off"
          />
          <button type="submit">Buscar</button>
        </fieldset>
        <div
          class={styles['search-status']}
          id="hero-search-status"
          aria-live="polite"
        ></div>
        <div
          class={styles['search-dropdown']}
          id="hero-search-results"
          hidden
          role="region"
          aria-label="Resultados de búsqueda"
        >
          <div class={styles['search-dropdown-content']}></div>
        </div>
      </form>
      <div class={styles.actions}>
        <a class={styles.primary} href={href(projectsUrl)}>
          Ver proyectos <span aria-hidden="true">→</span>
        </a>
        <a class={styles.secondary} href={href(contactUrl)}>
          Contáctenos
        </a>
      </div>
      <ul class={styles.cantons} aria-label="Cantones asociados">
        {cantons.map(({ name, image, width, height }) => (
          <li>
            <span class={styles['canton-name']}>{name}</span>
            <span class={styles.crest}>
              <img src={image.src} width={width} height={height} alt="" />
            </span>
          </li>
        ))}
      </ul>
    </div>
    <aside
      class={styles.governance}
      aria-labelledby="hero-governance-title"
      data-hero-carousel
    >
      <div class={styles['carousel-stage']} data-carousel-stage>
        <div
          class={styles['governance-slide']}
          data-slide-index="0"
          data-active="true"
        >
          <p class={styles['governance-eyebrow']}>{initialSlide.eyebrow}</p>
          <h2 id="hero-governance-title">{initialSlide.title}</h2>
          <ul class={styles['governance-list']}>
            {initialSlide.items.map(({ title, description, tone }) => (
              <li class:list={[styles['governance-card'], tone]}>
                <h3>{title}</h3>
                <p>{description}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <template id="hero-carousel-slides-data">
        {remainingSlides.map((slide, idx) => (
          <div
            class={styles['governance-slide']}
            data-slide-index={idx + 1}
            data-active="false"
          >
            <p class={styles['governance-eyebrow']}>{slide.eyebrow}</p>
            <h2 class={styles['slide-title']}>{slide.title}</h2>
            <ul class={styles['governance-list']}>
              {slide.items.map(({ title, description, tone, link }) => (
                <li class:list={[styles['governance-card'], tone]}>
                  <h3>{title}</h3>
                  <p>{description}</p>
                  {link && (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={styles['card-link']}
                      aria-label={`${link.label} para ${slide.title} (se abre en nueva pestaña)`}
                    >
                      <span>{link.label}</span>
                      <svg
                        viewBox="0 0 16 16"
                        width="12"
                        height="12"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M6 3h7v7" />
                        <path d="M13 3 7 9" />
                      </svg>
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </template>

      <div
        class="visually-hidden"
        data-carousel-status
        aria-live="polite"
        aria-atomic="true"
      ></div>

      <nav
        class={styles.pagination}
        aria-label="Paginación de convenios y gobernanza"
        data-carousel-pagination
        hidden
      >
        {slides.map((slide, idx) => (
          <button
            type="button"
            class={styles.dot}
            data-dot-index={idx}
            aria-label={`Ver diapositiva ${idx + 1} de ${slides.length}: ${slide.title}`}
            aria-current={idx === 0 ? 'true' : 'false'}
          />
        ))}
      </nav>
    </aside>
  </div>
  <div class={styles.band} aria-hidden="true"></div>
</section>

<script>
  function setupHeroSearch() {
    const form = document.querySelector<HTMLFormElement>('form[role="search"]');
    const input = document.getElementById(
      'hero-search',
    ) as HTMLInputElement | null;
    const status = document.getElementById('hero-search-status');
    const dropdown = document.getElementById('hero-search-results');
    const content = dropdown?.querySelector<HTMLDivElement>(':scope > div');

    if (!form || !input || !dropdown || !content) return;
    const targetForm = form;
    const targetInput = input;
    const targetDropdown = dropdown;
    const targetContent = content;

    let debounceTimer: ReturnType<typeof setTimeout> | undefined;

    const staticItems = [
      {
        title: 'Municipalidad de Parrita',
        type: 'Cantón',
        subtitle:
          'Cantón miembro · Cabecera: Parrita · Alcaldía: Roberto Alonso Rímola Real',
        url: '/municipalidades#municipality-parrita',
        keywords: 'parrita esterillos pirris pacifico',
      },
      {
        title: 'Municipalidad de Limón',
        type: 'Cantón',
        subtitle:
          'Cabecera Provincial · Puerto Principal · Alcaldía: Ana Janniel Matarrita Mc Calla',
        url: '/municipalidades#municipality-limon',
        keywords: 'limon puerto caribe',
      },
      {
        title: 'Municipalidad de Pococí',
        type: 'Cantón',
        subtitle:
          'Caribe Norte · Guápiles y Cariari · Alcaldía: Manuel Hernández Rivera',
        url: '/municipalidades#municipality-pococi',
        keywords: 'pococi guapiles cariari',
      },
      {
        title: 'Municipalidad de Talamanca',
        type: 'Cantón',
        subtitle:
          'Caribe Sur · Bribri, Cahuita, Sixaola · Alcaldía: Rugeli Morales Rodríguez',
        url: '/municipalidades#municipality-talamanca',
        keywords: 'talamanca bribri cahuita sixaola',
      },
      {
        title: 'Municipalidad de Matina',
        type: 'Cantón',
        subtitle:
          'Corredor Agrícola · Batán, Carrandi · Alcaldía: Walter Céspedes Salazar',
        url: '/municipalidades#municipality-matina',
        keywords: 'matina batan carrandi',
      },
      {
        title: 'Municipalidad de Guácimo',
        type: 'Cantón',
        subtitle:
          'Caribe Central · Innovación Agropecuaria · Alcaldía: Beatriz Mora Valverde',
        url: '/municipalidades#municipality-guacimo',
        keywords: 'guacimo caribe',
      },
      {
        title: 'Cartera de Inversión y Proyectos',
        type: 'Proyecto',
        subtitle: 'Proyectos institucionales y obras de la federación',
        url: '/proyectos',
        keywords:
          'proyectos inversion obras infraestructura estadio mojones planta electrolinera picc',
      },
      {
        title: 'Transparencia, Acuerdos y Documentos',
        type: 'Transparencia',
        subtitle:
          'Rendición de cuentas, actas de consejo y presupuestos auditados',
        url: '/transparencia',
        keywords:
          'transparencia acuerdos actas presupuesto liquidacion sicop tramites libros',
      },
      {
        title: 'Sala de Prensa y Noticias Oficiales',
        type: 'Noticias',
        subtitle: 'Comunicados y notas de prensa de la región caribeña',
        url: '/noticias',
        keywords: 'noticias prensa comunicados mopt inder convenios puentes',
      },
      {
        title: 'Quiénes Somos y Estatutos',
        type: 'Institucional',
        subtitle: 'Marco legal, objetivos y régimen de la federación',
        url: '/nosotros',
        keywords:
          'nosotros federacion estatutos codigo municipal leyes mision vision',
      },
    ];

    async function performSearch(query: string) {
      const q = query.trim();
      if (q.length < 2) {
        targetDropdown.hidden = true;
        if (status) status.textContent = '';
        return;
      }

      if (status) status.textContent = 'Buscando...';

      let results: Array<{
        title: string;
        type_label?: string;
        type?: string;
        subtitle?: string;
        url: string;
        snippet?: string;
      }> = [];

      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 4000);
        const res = await fetch(
          `https://cms.femucaribe.go.cr/wp-json/femucaribe/v1/search?q=${encodeURIComponent(q)}&limit=10`,
          {
            signal: controller.signal,
            headers: { Accept: 'application/json' },
          },
        );
        clearTimeout(timeout);
        if (res.ok) {
          const data = await res.json();
          results = data.results || [];
        }
      } catch {
        // Fallback to local search
      }

      if (results.length === 0) {
        const lower = q.toLowerCase();
        results = staticItems
          .filter(
            (item) =>
              item.title.toLowerCase().includes(lower) ||
              item.keywords.toLowerCase().includes(lower) ||
              item.subtitle.toLowerCase().includes(lower),
          )
          .map((item) => ({
            title: item.title,
            type_label: item.type,
            subtitle: item.subtitle,
            url: item.url,
          }));
      }

      renderResults(results, q);
    }

    function renderResults(
      results: Array<{
        title: string;
        type_label?: string;
        subtitle?: string;
        url: string;
        snippet?: string;
      }>,
      query: string,
    ) {
      if (results.length === 0) {
        targetContent.innerHTML = `<p data-empty>No se encontraron acuerdos, proyectos, trámites o cantones para "<strong>${escapeHtml(query)}</strong>".</p>`;
        targetDropdown.hidden = false;
        if (status) {
          status.textContent = `No se encontraron resultados para "${query}".`;
        }
        return;
      }

      const listHtml = results
        .map((item, idx) => {
          const badge = item.type_label
            ? `<span data-badge>${escapeHtml(item.type_label)}</span>`
            : '';
          const subtitle = item.subtitle
            ? `<p data-subtitle>${escapeHtml(item.subtitle)}</p>`
            : '';
          const snippet = item.snippet
            ? `<p data-snippet>${escapeHtml(item.snippet)}</p>`
            : '';
          return `
            <li role="option" id="search-opt-${idx}">
              <a href="${escapeHtml(item.url)}" data-item data-index="${idx}">
                <div data-result-header>
                  ${badge}
                  <h3 data-title>${escapeHtml(item.title)}</h3>
                </div>
                ${subtitle}
                ${snippet}
              </a>
            </li>
          `;
        })
        .join('');

      targetContent.innerHTML = `
        <div data-dropdown-header>
          <span>${results.length} ${results.length === 1 ? 'resultado encontrado' : 'resultados encontrados'}</span>
          <button type="button" data-close aria-label="Cerrar resultados">✕</button>
        </div>
        <ul data-list role="listbox">
          ${listHtml}
        </ul>
      `;

      targetDropdown.hidden = false;
      if (status) {
        status.textContent = `Se encontraron ${results.length} resultados para "${query}".`;
      }

      const closeBtn =
        targetContent.querySelector<HTMLButtonElement>('[data-close]');
      closeBtn?.addEventListener('click', () => {
        targetDropdown.hidden = true;
        targetInput.focus();
      });
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    targetInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => performSearch(targetInput.value), 250);
    });

    targetForm.addEventListener('submit', (e) => {
      e.preventDefault();
      performSearch(targetInput.value);
    });

    document.addEventListener('click', (e) => {
      if (!targetForm.contains(e.target as Node)) {
        targetDropdown.hidden = true;
      }
    });

    targetForm.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        targetDropdown.hidden = true;
      }
    });
  }

  function setupHeroCarousel() {
    const container = document.querySelector<HTMLElement>(
      '[data-hero-carousel]',
    );
    if (!container) return;
    const targetContainer = container;

    const stage = targetContainer.querySelector<HTMLElement>(
      '[data-carousel-stage]',
    );
    const template = targetContainer.querySelector<HTMLTemplateElement>(
      '#hero-carousel-slides-data',
    );
    const pagination = targetContainer.querySelector<HTMLElement>(
      '[data-carousel-pagination]',
    );
    const liveRegion = targetContainer.querySelector<HTMLElement>(
      '[data-carousel-status]',
    );

    if (!stage || !template || !pagination) return;

    const existingTimer = targetContainer.dataset.carouselTimer;
    if (existingTimer) {
      clearInterval(Number(existingTimer));
    }

    if (stage.children.length === 1) {
      const clone = template.content.cloneNode(true);
      stage.appendChild(clone);
    }

    const slides = Array.from(
      stage.querySelectorAll<HTMLElement>('[data-slide-index]'),
    );
    if (slides.length <= 1) return;

    pagination.hidden = false;
    const dots = Array.from(
      pagination.querySelectorAll<HTMLButtonElement>('[data-dot-index]'),
    );

    let currentIndex = 0;
    let isPaused = false;
    let timerId: ReturnType<typeof setInterval> | undefined;

    function announceSlide(index: number) {
      if (!liveRegion) return;
      const targetSlide = slides[index];
      const titleEl = targetSlide?.querySelector('h2');
      const title = titleEl?.textContent?.trim() ?? `Diapositiva ${index + 1}`;
      liveRegion.textContent = `Diapositiva ${index + 1} de ${slides.length}: ${title}`;
    }

    function goToSlide(nextIndex: number) {
      if (
        nextIndex === currentIndex ||
        nextIndex < 0 ||
        nextIndex >= slides.length
      ) {
        return;
      }

      const prevIndex = currentIndex;
      currentIndex = nextIndex;

      const currentSlide = slides[prevIndex];
      const nextSlide = slides[nextIndex];
      if (!currentSlide || !nextSlide) return;

      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      dots.forEach((dot, idx) => {
        dot.setAttribute('aria-current', idx === nextIndex ? 'true' : 'false');
      });

      if (prefersReducedMotion) {
        currentSlide.setAttribute('data-active', 'false');
        nextSlide.setAttribute('data-active', 'true');
        announceSlide(currentIndex);
        return;
      }

      currentSlide.setAttribute('data-transition', 'out');
      nextSlide.setAttribute('data-active', 'true');
      nextSlide.setAttribute('data-transition', 'in');

      setTimeout(() => {
        currentSlide.setAttribute('data-active', 'false');
        currentSlide.removeAttribute('data-transition');
        nextSlide.removeAttribute('data-transition');
        announceSlide(currentIndex);
      }, 200);
    }

    function nextSlide() {
      goToSlide((currentIndex + 1) % slides.length);
    }

    function prevSlide() {
      goToSlide((currentIndex - 1 + slides.length) % slides.length);
    }

    function startTimer() {
      if (timerId) clearInterval(timerId);
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      if (prefersReducedMotion) return;

      timerId = setInterval(() => {
        if (!isPaused) {
          nextSlide();
        }
      }, 4500);
      targetContainer.dataset.carouselTimer = String(timerId);
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        goToSlide(idx);
        startTimer();
      });
    });

    targetContainer.addEventListener('mouseenter', () => {
      isPaused = true;
    });
    targetContainer.addEventListener('mouseleave', () => {
      isPaused = false;
    });

    targetContainer.addEventListener('focusin', () => {
      isPaused = true;
    });
    targetContainer.addEventListener('focusout', (e) => {
      if (!targetContainer.contains(e.relatedTarget as Node)) {
        isPaused = false;
      }
    });

    document.addEventListener('visibilitychange', () => {
      isPaused = document.hidden;
    });

    targetContainer.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        const nextIdx = (currentIndex + 1) % slides.length;
        goToSlide(nextIdx);
        dots[nextIdx]?.focus();
        startTimer();
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        const prevIdx = (currentIndex - 1 + slides.length) % slides.length;
        goToSlide(prevIdx);
        dots[prevIdx]?.focus();
        startTimer();
      }
    });

    let touchStartX = 0;
    let touchStartY = 0;
    targetContainer.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0]?.clientX ?? 0;
        touchStartY = e.changedTouches[0]?.clientY ?? 0;
        isPaused = true;
      },
      { passive: true },
    );

    targetContainer.addEventListener(
      'touchend',
      (e) => {
        isPaused = false;
        const touchEndX = e.changedTouches[0]?.clientX ?? 0;
        const touchEndY = e.changedTouches[0]?.clientY ?? 0;
        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;

        if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
          if (diffX < 0) {
            nextSlide();
          } else {
            prevSlide();
          }
          startTimer();
        }
      },
      { passive: true },
    );

    startTimer();
  }

  setupHeroSearch();
  setupHeroCarousel();
  document.addEventListener('astro:after-swap', () => {
    setupHeroSearch();
    setupHeroCarousel();
  });
</script>
