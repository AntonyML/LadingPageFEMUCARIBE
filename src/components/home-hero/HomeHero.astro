---
import talamanca from '../../assets/hero/talamanca.png';
import limon from '../../assets/hero/limon.png';
import matina from '../../assets/hero/matina.png';
import guacimo from '../../assets/hero/guacimo.png';
import pococi from '../../assets/hero/pococi.png';
import parrita from '../../assets/hero/parrita.png';
import styles from './styles.module.css';
import { getPageContent } from '../../lib/cms-page-content';

interface Props {
  projectsUrl: string;
  contactUrl: string;
}

const { projectsUrl, contactUrl } = Astro.props;
const cms = await getPageContent('inicio');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const cantons = [
  { name: 'Talamanca', image: talamanca, width: 95, height: 68 },
  { name: 'Limón', image: limon, width: 45, height: 60 },
  { name: 'Matina', image: matina, width: 100, height: 108 },
  { name: 'Guácimo', image: guacimo, width: 80, height: 80 },
  { name: 'Pococí', image: pococi, width: 90, height: 85 },
  { name: 'Parrita', image: parrita, width: 70, height: 72 },
];

interface GovernanceCardItem {
  title: string;
  description: string;
  tone?: string | undefined;
  link?: {
    href: string;
    label: string;
  };
}

interface GovernanceSlide {
  id: string;
  eyebrow: string;
  title: string;
  items: readonly GovernanceCardItem[];
}

const slides: readonly [GovernanceSlide, ...GovernanceSlide[]] = [
  {
    id: 'slide-gobernanza',
    eyebrow: 'Gobernanza regional',
    title: 'Articulación Intermunicipal',
    items: [
      {
        title: '6 Gobiernos Locales Unidos',
        description:
          'Talamanca, Limón, Matina, Guácimo, Pococí y Parrita integrados para el desarrollo regional.',
        tone: styles.cyan,
      },
      {
        title: 'Descentralización & Inversión',
        description:
          'Gestión conjunta de infraestructura pública, competitividad y bienestar comunitario.',
        tone: styles.lime,
      },
      {
        title: 'Marco Legal & Transparencia',
        description:
          'Entidad pública costarricense constituida bajo el Código Municipal de Costa Rica.',
        tone: styles.amber,
      },
    ],
  },
  {
    id: 'slide-convenio-marco',
    eyebrow: 'Convenio Intermunicipal',
    title: 'Convenio Marco de Cooperación',
    items: [
      {
        title: 'Partes Suscriptoras',
        description:
          'Municipalidades del Caribe, Sarapiquí y Federación CAPROBA.',
        tone: styles.cyan,
      },
      {
        title: 'Objeto de Cooperación',
        description:
          'Cooperación intermunicipal para el desarrollo territorial y proyectos conjuntos.',
        tone: styles.lime,
      },
      {
        title: 'Registro Institucional',
        description:
          'Alianza estratégica oficial inscrita en el registro institucional de convenios.',
        tone: styles.amber,
        link: {
          href: 'https://www.caproba.go.cr/plan-estrategico-caproba-2017-20121/alianzas/',
          label: 'Consultar fuente institucional',
        },
      },
    ],
  },
  {
    id: 'slide-convenio-uci',
    eyebrow: 'Cooperación Académica',
    title: 'Universidad para la Cooperación Internacional (UCI)',
    items: [
      {
        title: 'Partes Suscriptoras',
        description:
          'Universidad para la Cooperación Internacional (UCI) y Federación.',
        tone: styles.cyan,
      },
      {
        title: 'Objeto de Cooperación',
        description:
          'Capacitación técnica, fortalecimiento de capacidades locales y formación continua.',
        tone: styles.lime,
      },
      {
        title: 'Registro Institucional',
        description:
          'Convenio formal de colaboración académica y desarrollo regional.',
        tone: styles.amber,
        link: {
          href: 'https://www.caproba.go.cr/plan-estrategico-caproba-2017-20121/alianzas/',
          label: 'Consultar fuente institucional',
        },
      },
    ],
  },
  {
    id: 'slide-convenio-earth',
    eyebrow: 'Cooperación Académica',
    title: 'Universidad EARTH',
    items: [
      {
        title: 'Partes Suscriptoras',
        description: 'Universidad EARTH y Federación.',
        tone: styles.cyan,
      },
      {
        title: 'Objeto de Cooperación',
        description:
          'Investigación aplicada, sostenibilidad ambiental e innovación agroproductiva rural.',
        tone: styles.lime,
      },
      {
        title: 'Registro Institucional',
        description:
          'Alianza técnica para la productividad y el desarrollo sostenible regional.',
        tone: styles.amber,
        link: {
          href: 'https://www.caproba.go.cr/plan-estrategico-caproba-2017-20121/alianzas/',
          label: 'Consultar fuente institucional',
        },
      },
    ],
  },
  {
    id: 'slide-convenio-arias',
    eyebrow: 'Alianza Estratégica',
    title: 'Fundación Arias para la Paz',
    items: [
      {
        title: 'Partes Suscriptoras',
        description:
          'Fundación Arias para la Paz y el Desarrollo Humano y Federación.',
        tone: styles.cyan,
      },
      {
        title: 'Objeto de Cooperación',
        description:
          'Gobernanza participativa, fomento de la paz social y desarrollo comunitario.',
        tone: styles.lime,
      },
      {
        title: 'Registro Institucional',
        description:
          'Alianza estratégica inscrita en el registro institucional de convenios.',
        tone: styles.amber,
        link: {
          href: 'https://www.caproba.go.cr/plan-estrategico-caproba-2017-20121/alianzas/',
          label: 'Consultar fuente institucional',
        },
      },
    ],
  },
  {
    id: 'slide-convenio-asamblea',
    eyebrow: 'Cooperación del Estado',
    title: 'Asamblea Legislativa de Costa Rica',
    items: [
      {
        title: 'Partes Suscriptoras',
