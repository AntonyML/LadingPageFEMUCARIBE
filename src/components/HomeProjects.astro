---
interface Props {
  projectsUrl?: string;
}

const { projectsUrl = '/proyectos' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function href(url: string) {
  if (url !== url.trim() || url.includes('\\')) {
    throw new Error(
      'HomeProjects destinations must be site-root paths or HTTP(S) URLs',
    );
  }
  if (/^\/(?!\/)/.test(url)) return `${base}${url}`;
  const parsed = new URL(url);
  if (!['http:', 'https:'].includes(parsed.protocol)) {
    throw new Error(
      'HomeProjects destinations must be site-root paths or HTTP(S) URLs',
    );
  }
  return url;
}

interface ProjectItem {
  category: string;
  title: string;
  description: string;
  status: string;
  accentColor: string;
  statusBg: string;
  statusColor: string;
}

const projects: readonly ProjectItem[] = [
  {
    category: 'Formulación y Ejecución',
    title: 'Unidad Gestora de Proyectos (UGP)',
    description:
      'Estructura técnica especializada de FEMUCARIBE encargada de formular la cartera de proyectos de inversión pública regional, gestionar fuentes de financiamiento y fiscalizar su ejecución conforme a la normativa de contratación pública.',
    status: 'En ejecución',
    accentColor: '#10b981',
    statusBg: 'var(--theme-status-positive-bg)',
    statusColor: 'var(--theme-status-positive-text)',
  },
  {
    category: 'Movilidad Eléctrica y Energía',
    title: 'Electrolinera',
    description:
      'Centro de carga rápida para transporte liviano y comercial en el corredor Atlántico, reduciendo emisiones de carbono e impulsando la descarbonización del sector transporte.',
    status: 'En operación',
    accentColor: '#aac651',
    statusBg: 'var(--theme-status-positive-bg)',
    statusColor: 'var(--theme-status-positive-text)',
  },
  {
    category: 'Innovación y Conocimiento',
    title: 'Parque Tecnológico y Productivo',
    description:
      'Plataforma para incubación de empresas de base tecnológica, transferencia técnica y capacitación orientada a jóvenes de la provincia de Limón.',
    status: 'En formulación',
    accentColor: '#1dc4da',
    statusBg: 'var(--theme-surface-accent)',
    statusColor: 'var(--theme-link)',
  },
  {
    category: 'Gestión Ambiental y Circular',
    title: 'Planta Recicladora',
    description:
      'Infraestructura de valorización de residuos sólidos urbanos con enfoque de economía circular, apoyando a las municipalidades en el cumplimiento de la Ley 8839.',
    status: 'En operación',
    accentColor: '#aac651',
    statusBg: 'var(--theme-status-positive-bg)',
    statusColor: 'var(--theme-status-positive-text)',
  },
];
---

<section class="home-projects" aria-labelledby="home-projects-title">
  <div class="header">
    <h2 id="home-projects-title" class="title">
      Proyectos Estratégicos en Marcha
    </h2>
    <a class="projects-link" href={href(projectsUrl)}>
      Ver cartera completa de proyectos (04 · Proyectos)
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <ul class="projects-list">
    {projects.map(
      ({
        category,
        title,
        description,
        status,
        accentColor,
        statusBg,
        statusColor,
      }) => (
        <li class="project-item">
          <article class="card">
            <span
              class="stripe"
              style={`background-color: ${accentColor};`}
              aria-hidden="true"
            />
            <div class="meta-row">
              <div
                class="icon-wrapper"
                style={`background-color: ${statusBg}; color: ${statusColor};`}
                aria-hidden="true"
              >
                <svg
                  class="icon"
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M12 2L2 7L12 12L22 7L12 2ZM2 17L12 22L22 17"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>
              <span
                class="status-badge"
                style={`background-color: ${statusBg}; color: ${statusColor};`}
              >
                {status}
              </span>
            </div>
            <div class="header-group">
              <span class="category">{category}</span>
              <h3 class="card-title">{title}</h3>
            </div>
            <div class="desc-box">
              <p class="description">{description}</p>
            </div>
          </article>
        </li>
      ),
    )}
  </ul>
</section>

<style>
  .home-projects {
    min-inline-size: 0;
    margin-block: 0.1875rem;
  }

  .header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-block-size: 2.75rem;
    margin-block-end: 1rem;
  }

  .title {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--theme-text);
  }

  .projects-link {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    min-block-size: 2.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--theme-link);
    text-decoration: none;
  }

  .projects-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .projects-link:focus-visible {
    outline: 2px solid var(--theme-link);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .projects-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .project-item {
    min-inline-size: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    block-size: 100%;
    min-inline-size: 0;
    padding: 1rem 1rem 1.25rem;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: 0.75rem;
  }

  .stripe {
    display: block;
    inline-size: 100%;
    block-size: 0.1875rem;
    margin-block-end: 0.25rem;
    border-radius: 0.0938rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .icon-wrapper {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 50%;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.625rem;
    font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.75rem);
    font-weight: 700;
    line-height: 1.2;
    border-radius: 0.6875rem;
  }

  .header-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-block-size: 3.25rem;
  }

  .category {
    font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.75rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--theme-link);
  }

  .card-title {
    margin: 0;
    font-size: clamp(0.9375rem, 0.875rem + 0.2vw, 1.0625rem);
    font-weight: 800;
    line-height: 1.3;
    color: var(--theme-text);
  }

  .desc-box {
    flex-grow: 1;
    padding: 0.75rem;
    background: var(--theme-surface-muted);
    border-radius: 0.5rem;
  }

  .description {
    margin: 0;
    font-size: clamp(0.7813rem, 0.75rem + 0.15vw, 0.875rem);
    font-weight: 400;
    line-height: 1.45;
    color: var(--theme-text-secondary);
  }

  @media (width >= 48rem) {
    .projects-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 75rem) {
    .projects-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @supports (container-type: inline-size) {
    .home-projects {
      container-type: inline-size;
    }

    @container (min-width: 48rem) {
      .projects-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @container (min-width: 70rem) {
      .projects-list {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }
  }
</style>
