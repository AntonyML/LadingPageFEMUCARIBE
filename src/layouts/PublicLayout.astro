---
import GovernmentBar from '../components/GovernmentBar.astro';
import PublicNavbar from '../components/PublicNavbar.astro';
import InstitutionalFooter from '../components/institutional-footer/InstitutionalFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const accesibilidadUrl = '/accesibilidad';
const contraloriaServiciosUrl =
  'https://www.mideplan.go.cr/contralorias-de-servicios';
const ley7600Url =
  'https://sinalevi.go.cr/ResultadosNormativa/Informacion?param1=23261&param2=96047&param3=1&param4=';
const websiteMetadata = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FEMUCARIBE',
  inLanguage: 'es',
  creator: {
    '@type': 'Person',
    name: 'Antony Monge López',
    email: 'antonyml2016@gmail.com',
    url: 'https://www.tonyml.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'FEMUCARIBE',
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Antony Monge López" />
    <title>{title}</title>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteMetadata).replace(/</g, '\\u003c')}
    />
  </head>
  <body class="public-site">
    <header>
      <GovernmentBar
        contentId="contenido-principal"
        destinations={{
          accessibility: `${base}${accesibilidadUrl}`,
          serviceComptroller: contraloriaServiciosUrl,
          law7600: ley7600Url,
        }}
      />
      <PublicNavbar />
    </header>
    <main id="contenido-principal" class="public-main" tabindex="-1">
      <slot name="hero" />
      <div class="site-container page-content">
        <slot />
      </div>
    </main>
    <InstitutionalFooter
      accessibilityUrl={accesibilidadUrl}
      privacyUrl="/legal#privacidad"
    />
  </body>
</html>
