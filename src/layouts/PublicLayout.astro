---
import GovernmentBar from '../components/GovernmentBar.astro';
import PublicNavbar from '../components/PublicNavbar.astro';
import InstitutionalFooter from '../components/institutional-footer/InstitutionalFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const accesibilidadUrl = '/accesibilidad';
const contraloriaServiciosUrl =
  'https://www.mideplan.go.cr/contralorias-de-servicios';
const ley7600Url =
  'https://sinalevi.go.cr/ResultadosNormativa/Informacion?param1=23261&param2=96047&param3=1&param4=';
const websiteMetadata = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FEMUCARIBE',
  inLanguage: 'es',
  creator: {
    '@type': 'Person',
    name: 'Antony Monge López',
    email: 'antonyml2016@gmail.com',
    url: 'https://www.tonyml.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'FEMUCARIBE',
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Antony Monge López" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const storageKey = 'femucaribe-theme';
        const allowedPreferences = ['light', 'dark', 'system'];
        const root = document.documentElement;
        const systemPreference = window.matchMedia(
          '(prefers-color-scheme: dark)',
        );
        const readPreference = () => {
          try {
            const storedPreference = localStorage.getItem(storageKey);
            return allowedPreferences.includes(storedPreference)
              ? storedPreference
              : 'system';
          } catch {
            return 'system';
          }
        };
        let preference = readPreference();

        const syncControls = () => {
          const isDark = root.classList.contains('dark');
          const nextTheme = isDark ? 'claro' : 'oscuro';
          document
            .querySelectorAll('[data-theme-toggle]')
            .forEach((control) => {
              const label = `Cambiar al tema ${nextTheme}`;
              control.dataset.tooltip = label;
              control.setAttribute('aria-label', label);
              control.setAttribute('aria-pressed', String(isDark));
            });
        };

        const paintTheme = () => {
          const isDark =
            preference === 'dark' ||
            (preference === 'system' && systemPreference.matches);
          root.classList.toggle('dark', isDark);
          root.dataset.themePreference = preference;
          syncControls();
        };

        const setPreference = (nextPreference, persist = true) => {
          if (!allowedPreferences.includes(nextPreference)) return;
          preference = nextPreference;
          paintTheme();
          if (persist) {
            try {
              localStorage.setItem(storageKey, preference);
              delete root.dataset.themePersistence;
            } catch {
              root.dataset.themePersistence = 'unavailable';
            }
          }
        };

        paintTheme();
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const control = target.closest('[data-theme-toggle]');
          if (!(control instanceof HTMLButtonElement)) return;
          setPreference(root.classList.contains('dark') ? 'light' : 'dark');
        });
        document.addEventListener('DOMContentLoaded', syncControls, {
          once: true,
        });
        document.addEventListener('astro:page-load', syncControls);
        systemPreference.addEventListener('change', () => {
          if (preference === 'system') paintTheme();
        });
        window.addEventListener('storage', (event) => {
          if (event.key !== storageKey) return;
          const nextPreference = allowedPreferences.includes(event.newValue)
            ? event.newValue
            : 'system';
          setPreference(nextPreference, false);
        });
        syncControls();
      })();
    </script>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteMetadata).replace(/</g, '\\u003c')}
    />
  </head>
  <body class="public-site">
    <header>
      <GovernmentBar
        contentId="contenido-principal"
        destinations={{
          accessibility: `${base}${accesibilidadUrl}`,
          serviceComptroller: contraloriaServiciosUrl,
          law7600: ley7600Url,
        }}
      />
      <PublicNavbar platformUrl={`${base}/acceso`} />
    </header>
    <main id="contenido-principal" class="public-main" tabindex="-1">
      <slot name="hero" />
      <div class="site-container page-content">
        <slot />
      </div>
    </main>
    <InstitutionalFooter
      accessibilityUrl={accesibilidadUrl}
      privacyUrl="/privacidad"
    />
    <script is:inline>
      window.ACCESSIBILITY_WIDGET_CONFIG = {
        language: 'es',
        position: 'bottom-right',
        color: '#0470a0',
      };
    </script>
    <script is:inline src={`${base}/js/accessibility-widget.min.js`}></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // Enlazar el botón de accesibilidad de la barra superior al widget modal
        const a11yLink = document.querySelector(
          '.government-bar .accessibility',
        );
        if (a11yLink) {
          a11yLink.setAttribute('role', 'button');
          a11yLink.setAttribute('aria-haspopup', 'dialog');
          a11yLink.addEventListener('click', (e) => {
            e.preventDefault();
            if (typeof window.toggleAccessibilityWidget === 'function') {
              window.toggleAccessibilityWidget();
            } else if (typeof window.openAccessibilityWidget === 'function') {
              window.openAccessibilityWidget();
            }
          });
        }

        // Manejo del salto al contenido principal
        const skipLink = document.querySelector('.government-bar .skip-link');
        if (skipLink) {
          skipLink.addEventListener('click', (e) => {
            const main = document.getElementById('contenido-principal');
            if (!main) return;

            const hero = main.querySelector('.home-hero');
            const pageContent = main.querySelector('.page-content');

            if (hero && pageContent) {
              e.preventDefault();
              main.focus({ preventScroll: true });
              pageContent.scrollIntoView({
                behavior: 'smooth',
                block: 'start',
              });
              history.pushState(null, '', '#contenido-principal');
            } else {
              e.preventDefault();
              main.focus({ preventScroll: true });
              main.scrollIntoView({ behavior: 'smooth', block: 'start' });
              history.pushState(null, '', '#contenido-principal');
            }
          });
        }

        if (window.location.hash === '#contenido-principal') {
          const main = document.getElementById('contenido-principal');
          const hero = main?.querySelector('.home-hero');
          const pageContent = main?.querySelector('.page-content');
          if (hero && pageContent) {
            setTimeout(() => {
              main.focus({ preventScroll: true });
              pageContent.scrollIntoView({
                behavior: 'smooth',
                block: 'start',
              });
            }, 100);
          }
        }
      });
    </script>
  </body>
</html>
