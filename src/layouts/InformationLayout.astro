---
import PublicLayout from './PublicLayout.astro';

interface Props {
  title: string;
  description: string;
  page: 'accesibilidad' | 'creditos' | 'legal' | 'privacidad';
}

const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageLabels = {
  accesibilidad: 'Accesibilidad',
  creditos: 'Créditos',
  legal: 'Aviso legal',
  privacidad: 'Privacidad',
} as const;
const sections = [
  ['accesibilidad', 'Accesibilidad'],
  ['creditos', 'Créditos'],
  ['legal', 'Aviso legal'],
  ['privacidad', 'Privacidad'],
] as const;
---

<PublicLayout title={`${title} | FEMUCARIBE`}>
  <div class="information-page">
    <nav class="breadcrumb" aria-label="Ubicación">
      <a href={`${base}/`}>Inicio</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{pageLabels[page]}</span>
    </nav>
    <header class="information-header">
      <p class="eyebrow">Acerca de este sitio</p>
      <h1>{title}</h1>
      <p class="introduction">{description}</p>
    </header>
    <nav class="sections" aria-label="Información del sitio">
      {sections.map(([route, label]) => (
        <a
          href={`${base}/${route}`}
          aria-current={page === route ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <slot />
  </div>
</PublicLayout>

<style>
  .information-page {
    min-inline-size: 0;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    color: var(--theme-text-secondary);
    font-size: 0.875rem;
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: var(--theme-link);
    text-underline-offset: 0.25em;
  }

  .information-header {
    margin-block: 1.5rem 2rem;
    max-inline-size: 52rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--theme-link);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .introduction {
    margin-block: 1rem 0;
    max-inline-size: 64ch;
    color: var(--theme-text-secondary);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .sections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-block-end: 2rem;
    border-block-end: 1px solid var(--theme-border);
  }

  .sections a {
    display: flex;
    align-items: center;
    min-block-size: 48px;
    padding: 0.75rem 0.25rem;
    border-block-end: 3px solid transparent;
    color: var(--theme-text-secondary);
    font-weight: 600;
    text-decoration: none;
  }

  .sections a[aria-current='page'] {
    border-block-end-color: var(--theme-link);
    color: var(--theme-link);
  }

  .sections a:hover {
    color: var(--theme-link);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
