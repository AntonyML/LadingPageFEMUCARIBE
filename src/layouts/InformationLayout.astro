---
import PublicLayout from './PublicLayout.astro';

interface Props {
  title: string;
  description: string;
  page: 'creditos' | 'legal';
}

const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = [
  ['creditos', 'Créditos'],
  ['legal', 'Aviso legal y privacidad'],
] as const;
---

<PublicLayout title={`${title} | FEMUCARIBE`}>
  <div class="information-page">
    <nav class="breadcrumb" aria-label="Ubicación">
      <a href={`${base}/`}>Inicio</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">
        {page === 'creditos' ? 'Créditos' : 'Aviso legal'}
      </span>
    </nav>
    <header class="information-header">
      <p class="eyebrow">Acerca de este sitio</p>
      <h1>{title}</h1>
      <p class="introduction">{description}</p>
    </header>
    <nav class="sections" aria-label="Información del sitio">
      {sections.map(([route, label]) => (
        <a
          href={`${base}/${route}`}
          aria-current={page === route ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <slot />
  </div>
</PublicLayout>

<style>
  .information-page {
    min-inline-size: 0;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    color: #435362;
    font-size: 0.875rem;
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: #0470a0;
    text-underline-offset: 0.25em;
  }

  .information-header {
    margin-block: 1.5rem 2rem;
    max-inline-size: 52rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #0470a0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .introduction {
    margin-block: 1rem 0;
    max-inline-size: 64ch;
    color: #435362;
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .sections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-block-end: 2rem;
    border-block-end: 1px solid #e2e8f0;
  }

  .sections a {
    display: flex;
    align-items: center;
    min-block-size: 48px;
    padding: 0.75rem 0.25rem;
    border-block-end: 3px solid transparent;
    color: #435362;
    font-weight: 600;
    text-decoration: none;
  }

  .sections a[aria-current='page'] {
    border-block-end-color: #0470a0;
    color: #0470a0;
  }

  .sections a:hover {
    color: #0470a0;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
