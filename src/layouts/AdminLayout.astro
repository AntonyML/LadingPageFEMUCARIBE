---
import '../styles/global.css';

interface Props {
  title: string;
  activeSection?: 'resumen' | 'documentos' | 'municipalidades' | 'noticias';
}

const { title, activeSection = 'resumen' } = Astro.props;
const user = Astro.locals.user;
const userEmail = user?.email || 'soporte@femucaribe.go.cr';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | FEMUCARIBE Admin</title>
    <script is:inline>
      (() => {
        const storageKey = 'femucaribe-theme';
        const allowedPreferences = ['light', 'dark', 'system'];
        const root = document.documentElement;
        const systemPreference = window.matchMedia(
          '(prefers-color-scheme: dark)',
        );
        const readPreference = () => {
          try {
            const storedPreference = localStorage.getItem(storageKey);
            return allowedPreferences.includes(storedPreference)
              ? storedPreference
              : 'system';
          } catch {
            return 'system';
          }
        };
        const preference = readPreference();
        const resolvedTheme =
          preference === 'system'
            ? systemPreference.matches
              ? 'dark'
              : 'light'
            : preference;
        root.classList.toggle('dark', resolvedTheme === 'dark');
      })();
    </script>
  </head>
  <body>
    <div class="admin-shell">
      <header class="admin-header">
        <div class="admin-header-content site-container">
          <div class="admin-brand">
            <a href={`${base}/admin`} class="brand-link">
              <span class="brand-badge">FEMUCARIBE</span>
              <span class="brand-title">Panel Administrativo</span>
            </a>
          </div>

          <div class="admin-user-nav">
            <span class="user-pill" title={`Sesión activa: ${userEmail}`}>
              <svg
                aria-hidden="true"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span class="user-email">{userEmail}</span>
            </span>

            <a
              href={`${base}/`}
              class="nav-ghost-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                aria-hidden="true"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span>Ver sitio</span>
            </a>

            <form
              action={`${base}/api/auth/logout`}
              method="POST"
              class="logout-form"
            >
              <button type="submit" class="logout-button" id="admin-logout-btn">
                <svg
                  aria-hidden="true"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                  <polyline points="16 17 21 12 16 7"></polyline>
                  <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Cerrar sesión</span>
              </button>
            </form>
          </div>
        </div>
      </header>

      <nav class="admin-nav" aria-label="Navegación del panel administrativo">
        <div class="admin-nav-content site-container">
          <ul class="nav-list" role="list">
            <li>
              <a
                href={`${base}/admin`}
                class:list={[
                  'nav-tab',
                  { active: activeSection === 'resumen' },
                ]}
                aria-current={activeSection === 'resumen' ? 'page' : undefined}
              >
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                <span>Resumen</span>
              </a>
            </li>
            <li>
              <a
                href={`${base}/admin/documentos`}
                class:list={[
                  'nav-tab',
                  { active: activeSection === 'documentos' },
                ]}
                aria-current={
                  activeSection === 'documentos' ? 'page' : undefined
                }
              >
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>Documentos</span>
              </a>
            </li>
            <li>
              <a
                href={`${base}/admin/municipalidades`}
                class:list={[
                  'nav-tab',
                  { active: activeSection === 'municipalidades' },
                ]}
                aria-current={
                  activeSection === 'municipalidades' ? 'page' : undefined
                }
              >
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 21h18"></path>
                  <path d="M5 21V7l8-4v18"></path>
                  <path d="M19 21V11l-6-3"></path>
                  <path d="M9 9h1"></path>
                  <path d="M9 13h1"></path>
                  <path d="M9 17h1"></path>
                </svg>
                <span>Municipalidades</span>
              </a>
            </li>
            <li>
              <a
                href={`${base}/admin/noticias`}
                class:list={[
                  'nav-tab',
                  { active: activeSection === 'noticias' },
                ]}
                aria-current={activeSection === 'noticias' ? 'page' : undefined}
              >
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path>
                  <path d="M18 14h-8"></path>
                  <path d="M15 18h-5"></path>
                  <path d="M10 6h8v4h-8V6Z"></path>
                </svg>
                <span>Noticias</span>
              </a>
            </li>
          </ul>
        </div>
      </nav>

      <main class="admin-main" id="admin-main">
        <div class="site-container">
          <slot />
        </div>
      </main>

      <footer class="admin-footer">
        <div class="site-container footer-content">
          <p>
            © {new Date().getFullYear()} Federación de Municipalidades de Limón
            (FEMUCARIBE). Plataforma de Administración.
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .admin-shell {
    min-block-size: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--theme-canvas);
    color: var(--theme-text);
  }

  .admin-header {
    background-color: var(--theme-surface);
    border-block-end: 1px solid var(--theme-border);
    padding-block: 1rem;
  }

  .admin-header-content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--theme-text);
  }

  .brand-badge {
    background-color: var(--theme-action);
    color: #fff;
    font-weight: 800;
    font-size: 0.8125rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .brand-title {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .admin-user-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .user-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--theme-text-secondary);
    background-color: var(--theme-surface-subtle);
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--theme-border-subtle);
  }

  .user-email {
    font-weight: 500;
  }

  .nav-ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--theme-link);
    text-decoration: none;
    padding: 0.375rem 0.625rem;
    border-radius: 6px;
    transition: background-color 0.15s ease;
  }

  .nav-ghost-link:hover {
    background-color: var(--theme-surface-subtle);
  }

  .logout-form {
    margin: 0;
  }

  .logout-button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #b91c1c;
    background: transparent;
    border: 1px solid rgb(185 28 28 / 20%);
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: inherit;
  }

  .logout-button:hover {
    background-color: rgb(185 28 28 / 8%);
    border-color: #b91c1c;
  }

  .admin-nav {
    background-color: var(--theme-surface);
    border-block-end: 1px solid var(--theme-border);
  }

  .nav-list {
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
    overflow-x: auto;
  }

  .nav-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--theme-text-secondary);
    text-decoration: none;
    border-block-end: 3px solid transparent;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .nav-tab:hover {
    color: var(--theme-text);
    background-color: var(--theme-surface-subtle);
  }

  .nav-tab.active {
    color: var(--theme-action);
    border-block-end-color: var(--theme-action);
    background-color: var(--theme-surface-subtle);
  }

  .admin-main {
    flex: 1;
    padding-block: 2rem;
  }

  .admin-footer {
    border-block-start: 1px solid var(--theme-border);
    background-color: var(--theme-surface);
    padding-block: 1.5rem;
    font-size: 0.8125rem;
    color: var(--theme-text-muted);
    text-align: center;
  }

  .footer-content {
    margin: 0 auto;
  }
</style>
