---
import PublicLayout from '../layouts/PublicLayout.astro';
import HomeHero from '../components/home-hero/HomeHero.astro';
import HomeQuickAccess from '../components/HomeQuickAccess.astro';
import HomeNews from '../components/home-news/HomeNews.astro';
import HomeLocalGovernments from '../components/HomeLocalGovernments.astro';
import HomeProjects from '../components/HomeProjects.astro';
import HomeTransparencyBanner from '../components/HomeTransparencyBanner.astro';
import HomeFaq from '../components/HomeFaq.astro';
import { fetchNewsArticles } from '../lib/cms-news';

const articles = await fetchNewsArticles();
const recentNews = articles.slice(0, 3);
---

<PublicLayout title="Inicio | FEMUCARIBE">
  <HomeHero slot="hero" projectsUrl="/proyectos" contactUrl="/contacto" />
  <HomeQuickAccess />
  <HomeNews items={recentNews} newsroomUrl="/noticias" />
  <HomeLocalGovernments />
  <HomeProjects />
  <HomeTransparencyBanner />
  <HomeFaq />
</PublicLayout>
