---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="Gestión de Municipalidades" activeSection="municipalidades">
  <div class="module-header">
    <div>
      <span class="module-kicker">Territorio y Cantones</span>
      <h1 class="module-title">Gestión de Municipalidades</h1>
      <p class="module-desc">
        Configuración no-code de información cantonal, alcaldías, concejos y
        banderas institucionales.
      </p>
    </div>
  </div>

  <section class="placeholder-card">
    <div class="card-icon" aria-hidden="true">
      <svg
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M3 21h18"></path>
        <path d="M5 21V7l8-4v18"></path>
        <path d="M19 21V11l-6-3"></path>
      </svg>
    </div>
    <h2>Editor No-Code de Cantones</h2>
    <p>
      Permitirá actualizar la descripción institucional, alcaldías y datos de
      contacto de Limón, Pococí, Siquirres, Talamanca, Matina y Guácimo
      directamente desde esta consola sin requerir conocimientos técnicos.
    </p>
  </section>
</AdminLayout>

<style>
  .module-header {
    margin-block-end: 2rem;
    padding-block-end: 1.5rem;
    border-block-end: 1px solid var(--theme-border);
  }

  .module-kicker {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--theme-action);
  }

  .module-title {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.75rem;
    font-weight: 800;
  }

  .module-desc {
    margin: 0;
    color: var(--theme-text-secondary);
  }

  .placeholder-card {
    background-color: var(--theme-surface);
    border: 1px dashed var(--theme-border);
    border-radius: 12px;
    padding: 3rem 2rem;
    text-align: center;
    max-inline-size: 40rem;
    margin: 2rem auto;
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 4rem;
    block-size: 4rem;
    border-radius: 50%;
    background-color: rgb(22 163 74 / 10%);
    color: #16a34a;
    margin-block-end: 1.5rem;
  }

  .placeholder-card h2 {
    margin: 0 0 0.75rem;
    font-size: 1.375rem;
  }

  .placeholder-card p {
    margin: 0;
    color: var(--theme-text-secondary);
    line-height: 1.6;
  }
</style>
