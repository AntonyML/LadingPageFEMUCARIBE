---
import MunicipalityEditor from '../../components/admin-municipalities/MunicipalityEditor.astro';
import styles from '../../components/admin-municipalities/styles.module.css';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listMunicipalities } from '../../lib/municipalities-repository';

export const prerender = false;

const municipalities = await listMunicipalities();
const canton = Astro.url.searchParams.get('canton');
const selected =
  municipalities.find((municipality) => municipality.id === canton) ??
  municipalities[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const formatDate = (value: string) =>
  new Intl.DateTimeFormat('es-CR', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'America/Costa_Rica',
  }).format(new Date(value));
const imageUrl = (value: string) =>
  value.startsWith('/') ? `${base}${value}` : value;
---

<AdminLayout title="Gestión de Municipalidades" activeSection="municipalidades">
  <div class={styles.root}>
    <header class={styles.header}>
      <span class={styles.kicker}>Territorio y cantones</span>
      <h1 class="module-title">Gestión de Municipalidades</h1>
      <p>
        Actualice la información de los gobiernos locales de Limón. Los cambios
        guardados se publican inmediatamente en el portal de FEMUCARIBE.
      </p>
    </header>
    <nav aria-labelledby="canton-selector-title" class={styles.selector}>
      <h2 id="canton-selector-title">Seleccione un cantón</h2>
      <ul class:list={['layout-grid', styles['canton-grid']]} role="list">
        {municipalities.map((municipality) => (
          <li>
            <a
              class={styles['canton-link']}
              href={`${base}/admin/municipalidades?canton=${municipality.id}`}
              aria-current={
                selected?.id === municipality.id ? 'true' : undefined
              }
              data-canton-link={municipality.id}
            >
              <span class={styles['canton-emblem']} aria-hidden="true">
                {municipality.escudoUrl ? (
                  <img
                    src={imageUrl(municipality.escudoUrl)}
                    alt=""
                    width="48"
                    height="48"
                  />
                ) : (
                  municipality.name.replace('Municipalidad de ', '').slice(0, 2)
                )}
              </span>
              <span class={styles['canton-info']}>
                <strong>{municipality.name}</strong>
                <span class={styles.timestamp}>
                  Actualizada:{' '}
                  <time
                    datetime={municipality.updatedAt}
                    data-canton-updated={municipality.id}
                  >
                    {formatDate(municipality.updatedAt)}
                  </time>
                </span>
                {selected?.id === municipality.id && (
                  <span class={styles['selected-label']}>
                    Cantón seleccionado
                  </span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    {selected && <MunicipalityEditor municipality={selected} base={base} />}
  </div>
</AdminLayout>
