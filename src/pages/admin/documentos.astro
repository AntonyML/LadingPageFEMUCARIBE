---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  getAllDocuments,
  DOCUMENT_CATEGORIES,
  CANTON_TAGS,
  formatFileSize,
} from '../../lib/documents-repository';
import { checkStorageHealth } from '../../lib/storage-client';
import {
  DOCUMENT_DESCRIPTION_MAX_LENGTH,
  DOCUMENT_FILE_ACCEPT,
  DOCUMENT_FILE_EXTENSIONS,
  DOCUMENT_FILE_TYPES_LABEL,
  DOCUMENT_MAX_FILE_SIZE,
  DOCUMENT_TITLE_MAX_LENGTH,
  DOCUMENT_TITLE_MIN_LENGTH,
  getCostaRicaDate,
} from '../../lib/document-validation';

export const prerender = false;

const initialDocuments = await getAllDocuments();
const storageHealth = await checkStorageHealth(2000);
const todayDate = getCostaRicaDate();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const uploadValidationRules = {
  extensions: DOCUMENT_FILE_EXTENSIONS,
  maxFileSize: DOCUMENT_MAX_FILE_SIZE,
  minTitleLength: DOCUMENT_TITLE_MIN_LENGTH,
  maxTitleLength: DOCUMENT_TITLE_MAX_LENGTH,
  maxDescriptionLength: DOCUMENT_DESCRIPTION_MAX_LENGTH,
  todayDate,
};
---

<AdminLayout title="Gestión de Documentos" activeSection="documentos">
  <div class="documents-header">
    <div class="header-intro">
      <span class="section-kicker">Transparencia y Archivos</span>
      <h1 class="header-title module-title">Documentos Institucionales</h1>
      <p class="header-desc">
        Subida, catalogación y gestión oficial de actas, convenios, reglamentos
        y estados financieros de FEMUCARIBE.
      </p>
    </div>

    <div
      class="storage-monitor"
      id="storage-monitor"
      class:list={[{ 'is-online': storageHealth.online }]}
    >
      <div class="monitor-icon" aria-hidden="true">
        <span class="status-indicator"></span>
      </div>
      <div class="monitor-details">
        <span class="monitor-label">Servidor Storage (api-buket)</span>
        <span class="monitor-status" id="monitor-status-text">
          {storageHealth.online
            ? 'Conexión y credenciales verificadas'
            : 'Sin conexión con el túnel'}
        </span>
      </div>
    </div>
  </div>

  <!-- Formulario de Subida -->
  <section class="admin-card upload-section" aria-labelledby="upload-heading">
    <div class="card-header">
      <div class="card-title-group">
        <div class="card-icon-pill" aria-hidden="true">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </div>
        <div>
          <h2 id="upload-heading" class="card-title">
            Cargar Nuevo Documento Oficial
          </h2>
          <p class="card-subtitle">
            El archivo se transmitirá a la API de almacenamiento físico y se
            indexará en el catálogo institucional.
          </p>
        </div>
      </div>
    </div>

    <form
      id="document-upload-form"
      class="upload-form"
      enctype="multipart/form-data"
      novalidate
    >
      <!-- Zona Dropzone -->
      <div
        class="dropzone-area"
        id="dropzone"
        role="button"
        tabindex="0"
        aria-label="Seleccionar o arrastrar archivo"
      >
        <input
          type="file"
          id="file-input"
          name="file"
          class="file-input-hidden"
          accept={DOCUMENT_FILE_ACCEPT}
          required
          aria-describedby="file-hint"
        />
        <div class="dropzone-empty" id="dropzone-empty">
          <svg
            class="dropzone-icon"
            width="44"
            height="44"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
            <path d="M12 12v9"></path>
            <path d="m16 16-4-4-4 4"></path>
          </svg>
          <p class="dropzone-main-text">
            <strong>Arrastre el archivo aquí</strong> o{' '}
            <span class="action-highlight">explore en su equipo</span>
          </p>
          <span class="dropzone-hint" id="file-hint">
            Formatos aceptados: {DOCUMENT_FILE_TYPES_LABEL} (Máximo 50 MB)
          </span>
        </div>

        <div class="dropzone-selected" id="dropzone-selected" hidden>
          <div class="file-info-badge">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <div class="file-text">
              <span class="selected-name" id="selected-file-name">
                archivo.pdf
              </span>
              <span class="selected-size" id="selected-file-size">
                0 KB
              </span>
            </div>
          </div>
          <button
            type="button"
            class="btn-remove-file"
            id="btn-remove-file"
            title="Quitar archivo seleccionado"
          >
            Cambiar archivo
          </button>
        </div>
      </div>

      <!-- Campos de Metadata -->
      <div class="form-grid">
        <div class="form-group col-span-2">
          <label for="doc-title" class="form-label">
            Título Oficial del Documento <span class="required-star">*</span>
          </label>
          <input
            type="text"
            id="doc-title"
            name="title"
            class="form-input"
            placeholder="Ej: Acta Ordinaria N° 04-2026 de Consejo Directivo"
            required
            minlength={DOCUMENT_TITLE_MIN_LENGTH}
            maxlength={DOCUMENT_TITLE_MAX_LENGTH}
            aria-describedby="doc-title-hint"
          />
          <small class="form-hint" id="doc-title-hint">
            Use entre {DOCUMENT_TITLE_MIN_LENGTH} y {DOCUMENT_TITLE_MAX_LENGTH}{' '}
            caracteres.
          </small>
        </div>

        <div class="form-group">
          <label for="doc-category" class="form-label">
            Categoría Institucional <span class="required-star">*</span>
          </label>
          <select
            id="doc-category"
            name="category"
            class="form-select"
            required
          >
            <option value="" disabled selected>
              Seleccione una categoría...
            </option>
            {DOCUMENT_CATEGORIES.map((cat) => (
              <option value={cat.id}>{cat.label}</option>
            ))}
          </select>
        </div>

        <div class="form-group">
          <label for="doc-canton" class="form-label">
            Cantón / Ámbito <span class="required-star">*</span>
          </label>
          <select id="doc-canton" name="canton" class="form-select" required>
            <option value="" disabled selected>
              Seleccione un cantón o ámbito...
            </option>
            {CANTON_TAGS.map((c) => (
              <option value={c}>{c}</option>
            ))}
          </select>
        </div>

        <div class="form-group">
          <label for="doc-date" class="form-label">
            Fecha de Emisión <span class="required-star">*</span>
          </label>
          <input
            type="date"
            id="doc-date"
            name="documentDate"
            class="form-input"
            value={todayDate}
            max={todayDate}
            required
            aria-describedby="doc-date-hint"
          />
          <small class="form-hint" id="doc-date-hint">
            La fecha no puede ser posterior a {todayDate}.
          </small>
        </div>

        <div class="form-group col-span-2">
          <label for="doc-desc" class="form-label">
            Resumen o Notas de Transparencia (Opcional)
          </label>
          <textarea
            id="doc-desc"
            name="description"
            class="form-textarea"
            rows="2"
            maxlength={DOCUMENT_DESCRIPTION_MAX_LENGTH}
            aria-describedby="doc-desc-hint doc-desc-count"
            placeholder="Detalles sobre acuerdos tomados, número de licitación o contexto del documento..."
          ></textarea>
          <div class="form-hint-row">
            <small class="form-hint" id="doc-desc-hint">
              Hasta {DOCUMENT_DESCRIPTION_MAX_LENGTH} caracteres.
            </small>
            <small class="form-hint" id="doc-desc-count" aria-live="off">
              0/{DOCUMENT_DESCRIPTION_MAX_LENGTH}
            </small>
          </div>
        </div>
      </div>

      <!-- Alertas de Estado -->
      <div
        id="upload-status"
        class="alert-box"
        hidden
        role="status"
        aria-live="polite"
      ></div>

      <!-- Botón de Envío -->
      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="btn-submit-doc">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
            <polyline points="17 21 17 13 7 13 7 21"></polyline>
            <polyline points="7 3 7 8 15 8"></polyline>
          </svg>
          <span id="btn-submit-text">Subir y Catalogar Documento</span>
        </button>
      </div>
    </form>
  </section>

  <!-- Catálogo de Documentos -->
  <section class="admin-card catalog-section" aria-labelledby="catalog-heading">
    <div class="catalog-header">
      <div>
        <h2 id="catalog-heading" class="card-title">
          Catálogo de Documentos Publicados
        </h2>
        <p class="card-subtitle">
          Listado de archivos registrados y custodiados en el servidor
          institucional.
        </p>
      </div>
      <div class="count-badge">
        <span id="doc-counter">{initialDocuments.length}</span> documentos
      </div>
    </div>

    <!-- Barra de Filtros -->
    <div class="filters-bar">
      <div class="search-input-wrapper">
        <svg
          aria-hidden="true"
          class="search-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="search-filter"
          class="filter-input"
          placeholder="Buscar por título, acta o archivo..."
          aria-label="Buscar en el catálogo"
        />
      </div>

      <div class="filters-group">
        <select
          id="category-filter"
          class="filter-select"
          aria-label="Filtrar por categoría"
        >
          <option value="all">Todas las categorías</option>
          {DOCUMENT_CATEGORIES.map((c) => (
            <option value={c.id}>{c.label}</option>
          ))}
        </select>

        <select
          id="canton-filter"
          class="filter-select"
          aria-label="Filtrar por cantón"
        >
          <option value="all">Todos los cantones</option>
          {CANTON_TAGS.map((c) => (
            <option value={c}>{c}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Tabla de Documentos -->
    <div class="table-container">
      <table class="documents-table" id="documents-table">
        <thead>
          <tr>
            <th scope="col">Documento / Archivo</th>
            <th scope="col">Categoría</th>
            <th scope="col">Cantón</th>
            <th scope="col">Fecha</th>
            <th scope="col" class="th-actions">
              Acciones
            </th>
          </tr>
        </thead>
        <tbody id="documents-tbody">
          {initialDocuments.length === 0 ? (
            <tr class="empty-row" id="empty-row">
              <td colspan="5" class="empty-cell">
                <div class="empty-state">
                  <svg
                    width="40"
                    height="40"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                  </svg>
                  <p class="empty-title">No hay documentos registrados aún</p>
                  <p class="empty-hint">
                    Utilice el formulario superior para cargar el primer archivo
                    oficial.
                  </p>
                </div>
              </td>
            </tr>
          ) : (
            initialDocuments.map((doc) => (
              <tr
                data-doc-id={doc.id}
                data-category={doc.category}
                data-canton={doc.canton}
              >
                <td>
                  <div class="doc-meta-cell">
                    <span class="doc-title-text">{doc.title}</span>
                    <div class="doc-submeta">
                      <span class="doc-filename">{doc.originalName}</span>
                      <span class="doc-filesize">
                        • {formatFileSize(doc.fileSize)}
                      </span>
                    </div>
                  </div>
                </td>
                <td>
                  <span class={`cat-pill cat-${doc.category}`}>
                    {DOCUMENT_CATEGORIES.find((c) => c.id === doc.category)
                      ?.label || doc.category}
                  </span>
                </td>
                <td>
                  <span class="canton-pill">{doc.canton}</span>
                </td>
                <td>
                  <time datetime={doc.documentDate} class="doc-date-text">
                    {doc.documentDate}
                  </time>
                </td>
                <td class="td-actions">
                  <div class="actions-group">
                    <a
                      href={doc.downloadUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-icon"
                      title="Descargar documento"
                      aria-label={`Descargar ${doc.title}`}
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                      </svg>
                    </a>

                    <button
                      type="button"
                      class="btn-icon btn-copy-url"
                      data-url={doc.downloadUrl}
                      title="Copiar enlace directo"
                      aria-label="Copiar enlace"
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <rect
                          x="9"
                          y="9"
                          width="13"
                          height="13"
                          rx="2"
                          ry="2"
                        ></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                      </svg>
                    </button>

                    <button
                      type="button"
                      class="btn-icon btn-delete-doc text-danger"
                      data-id={doc.id}
                      data-title={doc.title}
                      title="Eliminar documento"
                      aria-label={`Eliminar ${doc.title}`}
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Diálogo Modal de Confirmación de Borrado -->
  <dialog
    id="delete-confirm-dialog"
    class="admin-dialog"
    aria-labelledby="delete-dialog-title"
  >
    <div class="dialog-box">
      <div class="dialog-header-warning">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <h3 id="delete-dialog-title">¿Eliminar este documento oficial?</h3>
      </div>
      <p class="dialog-desc">
        Se eliminará permanentemente el archivo{' '}
        <strong id="delete-target-title"></strong> tanto del catálogo de
        metadatos como del almacenamiento físico en el servidor.
      </p>
      <div class="dialog-actions">
        <button type="button" class="btn btn-outline" id="btn-cancel-delete">
          Cancelar
        </button>
        <button type="button" class="btn btn-danger" id="btn-confirm-delete">
          Confirmar Eliminación
        </button>
      </div>
    </div>
  </dialog>
</AdminLayout>

<script is:inline define:vars={{ base, uploadValidationRules }}>
  (() => {
    // 1. Storage Status Refresh
    const monitorStatusText = document.getElementById('monitor-status-text');
    const storageMonitor = document.getElementById('storage-monitor');

    async function refreshStorageHealth() {
      try {
        const res = await fetch(`${base}/api/admin/storage/status`);
        if (res.ok) {
          const data = await res.json();
          if (data.online) {
            storageMonitor.classList.add('is-online');
            if (monitorStatusText)
              monitorStatusText.textContent =
                'Conexión y credenciales verificadas';
          } else {
            storageMonitor.classList.remove('is-online');
            if (monitorStatusText)
              monitorStatusText.textContent = data.error || 'Sin conexión';
          }
        }
      } catch {
        storageMonitor.classList.remove('is-online');
        if (monitorStatusText)
          monitorStatusText.textContent = 'Fallo de red al verificar';
      }
    }

    if (storageMonitor) {
      storageMonitor.addEventListener('click', () => {
        if (monitorStatusText)
          monitorStatusText.textContent = 'Verificando estado...';
        refreshStorageHealth();
      });
    }
    refreshStorageHealth();

    // 2. Dropzone & File Selection
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input');
    const dropzoneEmpty = document.getElementById('dropzone-empty');
    const dropzoneSelected = document.getElementById('dropzone-selected');
    const selectedName = document.getElementById('selected-file-name');
    const selectedSize = document.getElementById('selected-file-size');
    const btnRemoveFile = document.getElementById('btn-remove-file');
    const titleInput = document.getElementById('doc-title');
    const categoryInput = document.getElementById('doc-category');
    const cantonInput = document.getElementById('doc-canton');
    const dateInput = document.getElementById('doc-date');
    const descriptionInput = document.getElementById('doc-desc');
    const descriptionCount = document.getElementById('doc-desc-count');

    function formatBytes(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function setFile(file) {
      if (!file) {
        dropzoneEmpty.hidden = false;
        dropzoneSelected.hidden = true;
        fileInput.value = '';
        fileInput.setCustomValidity('');
        return;
      }

      const extension = file.name
        .slice(file.name.lastIndexOf('.'))
        .toLowerCase();
      let error = '';
      if (!uploadValidationRules.extensions.includes(extension)) {
        error = 'Formato no permitido. Use PDF, DOCX, XLSX, DOC o XLS';
      } else if (file.size === 0) {
        error = 'El archivo seleccionado está vacío';
      } else if (file.size > uploadValidationRules.maxFileSize) {
        error = 'El archivo excede el tamaño máximo permitido de 50 MB';
      }

      fileInput.setCustomValidity(error);
      dropzoneEmpty.hidden = true;
      dropzoneSelected.hidden = false;
      selectedName.textContent = file.name;
      selectedSize.textContent = formatBytes(file.size);
      if (error) {
        showStatus(error, 'danger');
      } else if (uploadStatus) {
        uploadStatus.hidden = true;
        uploadStatus.textContent = '';
      }
    }

    if (dropzone && fileInput) {
      dropzone.addEventListener('click', (e) => {
        if (e.target !== btnRemoveFile) fileInput.click();
      });

      dropzone.addEventListener('keydown', (e) => {
        if (e.target === btnRemoveFile) return;
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          fileInput.click();
        }
      });

      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files[0]) {
          setFile(fileInput.files[0]);
        }
      });

      if (btnRemoveFile) {
        btnRemoveFile.addEventListener('click', (e) => {
          e.stopPropagation();
          setFile(null);
        });
      }

      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropzone.classList.add('drag-active');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropzone.classList.remove('drag-active');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        if (e.dataTransfer && e.dataTransfer.files.length > 0) {
          fileInput.files = e.dataTransfer.files;
          setFile(e.dataTransfer.files[0]);
        }
      });
    }

    // 3. Document Upload Form Submission
    const uploadForm = document.getElementById('document-upload-form');
    const uploadStatus = document.getElementById('upload-status');
    const btnSubmit = document.getElementById('btn-submit-doc');
    const btnSubmitText = document.getElementById('btn-submit-text');

    function showStatus(message, type) {
      if (!uploadStatus) return;
      uploadStatus.textContent =
        readableErrorMessage(message) || String(message);
      uploadStatus.className = 'alert-box alert-' + type;
      uploadStatus.setAttribute('role', type === 'danger' ? 'alert' : 'status');
      uploadStatus.setAttribute(
        'aria-live',
        type === 'danger' ? 'assertive' : 'polite',
      );
      uploadStatus.hidden = false;
    }

    function readableErrorMessage(value, depth = 0) {
      if (depth > 5 || value == null) return '';
      if (typeof value === 'string') return value.trim().slice(0, 500);
      if (Array.isArray(value)) {
        return value
          .map((entry) => readableErrorMessage(entry, depth + 1))
          .filter(Boolean)
          .join('; ')
          .slice(0, 500);
      }
      if (typeof value === 'object') {
        for (const key of ['message', 'error', 'detail', 'description']) {
          const message = readableErrorMessage(value[key], depth + 1);
          if (message) return message;
        }
        try {
          return JSON.stringify(value).slice(0, 500);
        } catch {
          return '';
        }
      }
      return String(value).slice(0, 500);
    }

    function validateUploadForm() {
      const file = fileInput.files && fileInput.files[0];
      if (!file) {
        showStatus('Debe seleccionar un archivo oficial para cargar', 'danger');
        dropzone.focus();
        return false;
      }

      const extension = file.name
        .slice(file.name.lastIndexOf('.'))
        .toLowerCase();
      const fileError = !uploadValidationRules.extensions.includes(extension)
        ? 'Formato no permitido. Use PDF, DOCX, XLSX, DOC o XLS'
        : file.size === 0
          ? 'El archivo seleccionado está vacío'
          : file.size > uploadValidationRules.maxFileSize
            ? 'El archivo excede el tamaño máximo permitido de 50 MB'
            : '';
      fileInput.setCustomValidity(fileError);
      if (fileError) {
        showStatus(fileError, 'danger');
        dropzone.focus();
        return false;
      }

      const title = titleInput.value.trim();
      titleInput.setCustomValidity(
        title.length < uploadValidationRules.minTitleLength
          ? 'El título institucional debe contener al menos 3 caracteres'
          : title.length > uploadValidationRules.maxTitleLength
            ? 'El título institucional no puede superar los 200 caracteres'
            : '',
      );
      categoryInput.setCustomValidity(
        categoryInput.value ? '' : 'Seleccione una categoría institucional',
      );
      cantonInput.setCustomValidity(
        cantonInput.value ? '' : 'Seleccione un cantón o ámbito',
      );
      dateInput.setCustomValidity(
        dateInput.value && dateInput.value > uploadValidationRules.todayDate
          ? 'La fecha de emisión no puede ser posterior a hoy'
          : '',
      );
      descriptionInput.setCustomValidity(
        descriptionInput.value.length >
          uploadValidationRules.maxDescriptionLength
          ? 'El resumen no puede superar los 1000 caracteres'
          : '',
      );

      if (!uploadForm.reportValidity()) {
        const invalidField = uploadForm.querySelector(':invalid');
        showStatus(
          invalidField?.validationMessage ||
            'Revise los campos obligatorios y sus límites.',
          'danger',
        );
        if (invalidField && invalidField !== fileInput) invalidField.focus();
        return false;
      }

      return true;
    }

    if (descriptionInput && descriptionCount) {
      const updateDescriptionCount = () => {
        descriptionCount.textContent = `${descriptionInput.value.length}/${uploadValidationRules.maxDescriptionLength}`;
      };
      descriptionInput.addEventListener('input', updateDescriptionCount);
      updateDescriptionCount();
    }

    if (uploadForm) {
      uploadForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!validateUploadForm()) return;

        const formData = new FormData(uploadForm);
        btnSubmit.disabled = true;
        btnSubmitText.textContent = 'Transmitiendo al servidor...';
        showStatus(
          'Guardando archivo en el servidor y registrando metadatos...',
          'info',
        );

        try {
          const res = await fetch(`${base}/api/admin/documents/upload`, {
            method: 'POST',
            body: formData,
          });

          const responseText = await res.text();
          let data = {};
          try {
            data = responseText ? JSON.parse(responseText) : {};
          } catch {
            data = {};
          }

          if (res.ok && data.success) {
            showStatus('Documento subido y catalogado exitosamente', 'success');
            uploadForm.reset();
            setFile(null);
            setTimeout(() => {
              window.location.reload();
            }, 800);
          } else {
            showStatus(
              readableErrorMessage(data.error || data.message) ||
                `Error al procesar la subida del documento (HTTP ${res.status})`,
              'danger',
            );
          }
        } catch {
          showStatus('Fallo de red al conectar con el servidor', 'danger');
        } finally {
          btnSubmit.disabled = false;
          btnSubmitText.textContent = 'Subir y Catalogar Documento';
        }
      });
    }

    // 4. Filters & Search in Table
    const searchFilter = document.getElementById('search-filter');
    const categoryFilter = document.getElementById('category-filter');
    const cantonFilter = document.getElementById('canton-filter');
    const docCounter = document.getElementById('doc-counter');

    function applyFilters() {
      const q = (searchFilter?.value || '').toLowerCase().trim();
      const cat = categoryFilter?.value || 'all';
      const canton = cantonFilter?.value || 'all';

      const rows = document.querySelectorAll(
        '#documents-tbody tr:not(.empty-row)',
      );
      let visibleCount = 0;

      rows.forEach((row) => {
        const text = row.textContent.toLowerCase();
        const rowCat = row.getAttribute('data-category');
        const rowCanton = row.getAttribute('data-canton');

        const matchesQuery = !q || text.includes(q);
        const matchesCat = cat === 'all' || rowCat === cat;
        const matchesCanton = canton === 'all' || rowCanton === canton;

        if (matchesQuery && matchesCat && matchesCanton) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (docCounter) docCounter.textContent = String(visibleCount);
    }

    if (searchFilter) searchFilter.addEventListener('input', applyFilters);
    if (categoryFilter) categoryFilter.addEventListener('change', applyFilters);
    if (cantonFilter) cantonFilter.addEventListener('change', applyFilters);

    // 5. Copy URL action
    document.querySelectorAll('.btn-copy-url').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-url');
        if (!url) return;
        try {
          await navigator.clipboard.writeText(url);
          btn.classList.add('copied');
          setTimeout(() => btn.classList.remove('copied'), 1500);
        } catch {
          // fallback
        }
      });
    });

    // 6. Delete Action Dialog
    const deleteDialog = document.getElementById('delete-confirm-dialog');
    const targetTitleSpan = document.getElementById('delete-target-title');
    const btnCancelDelete = document.getElementById('btn-cancel-delete');
    const btnConfirmDelete = document.getElementById('btn-confirm-delete');
    let targetDocId = null;

    document.querySelectorAll('.btn-delete-doc').forEach((btn) => {
      btn.addEventListener('click', () => {
        targetDocId = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title');
        if (targetTitleSpan) targetTitleSpan.textContent = title;
        if (deleteDialog) deleteDialog.showModal();
      });
    });

    if (btnCancelDelete && deleteDialog) {
      btnCancelDelete.addEventListener('click', () => {
        deleteDialog.close();
        targetDocId = null;
      });
    }

    if (btnConfirmDelete && deleteDialog) {
      btnConfirmDelete.addEventListener('click', async () => {
        if (!targetDocId) return;
        btnConfirmDelete.disabled = true;

        try {
          const res = await fetch(
            `${base}/api/admin/documents/${encodeURIComponent(targetDocId)}`,
            {
              method: 'DELETE',
            },
          );

          if (res.ok) {
            deleteDialog.close();
            const row = document.querySelector(
              `tr[data-doc-id="${targetDocId}"]`,
            );
            if (row) row.remove();
            applyFilters();
          } else {
            alert('No se pudo eliminar el documento.');
          }
        } catch {
          alert('Error de red al intentar eliminar.');
        } finally {
          btnConfirmDelete.disabled = false;
          targetDocId = null;
        }
      });
    }
  })();
</script>

