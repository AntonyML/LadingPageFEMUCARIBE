---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const storageEndpoint =
  process.env.FEMUCARIBE_STORAGE_ENDPOINT || 'No configurado';
---

<AdminLayout title="Gestión de Documentos" activeSection="documentos">
  <div class="module-header">
    <div>
      <span class="module-kicker">Transparencia y Archivos</span>
      <h1 class="module-title">Documentos Institucionales</h1>
      <p class="module-desc">
        Administración y carga de actas, acuerdos de concejo, reglamentos y
        estados financieros.
      </p>
    </div>
    <div class="endpoint-badge">
      <span class="badge-dot"></span>
      <span class="badge-text">
        Storage API: <code>{storageEndpoint}</code>
      </span>
    </div>
  </div>

  <section class="placeholder-card">
    <div class="card-icon" aria-hidden="true">
      <svg
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="17 8 12 3 7 8"></polyline>
        <line x1="12" y1="3" x2="12" y2="15"></line>
      </svg>
    </div>
    <h2>Subida y Catalogación de Documentos</h2>
    <p>
      El backend está conectado a la API de almacenamiento independiente. La
      interfaz para cargar archivos, asignar categorías, fechas y números de
      acta se desplegará en la siguiente fase.
    </p>
  </section>
</AdminLayout>

<style>
  .module-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-end: 2rem;
    padding-block-end: 1.5rem;
    border-block-end: 1px solid var(--theme-border);
  }

  .module-kicker {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--theme-action);
  }

  .module-title {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.75rem;
    font-weight: 800;
  }

  .module-desc {
    margin: 0;
    color: var(--theme-text-secondary);
  }

  .endpoint-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    background-color: var(--theme-surface-subtle);
    border: 1px solid var(--theme-border);
    border-radius: 6px;
    font-size: 0.8125rem;
  }

  .badge-dot {
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    background-color: #16a34a;
  }

  .placeholder-card {
    background-color: var(--theme-surface);
    border: 1px dashed var(--theme-border);
    border-radius: 12px;
    padding: 3rem 2rem;
    text-align: center;
    max-inline-size: 40rem;
    margin: 2rem auto;
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 4rem;
    block-size: 4rem;
    border-radius: 50%;
    background-color: rgb(4 112 160 / 10%);
    color: var(--theme-action);
    margin-block-end: 1.5rem;
  }

  .placeholder-card h2 {
    margin: 0 0 0.75rem;
    font-size: 1.375rem;
  }

  .placeholder-card p {
    margin: 0;
    color: var(--theme-text-secondary);
    line-height: 1.6;
  }
</style>
