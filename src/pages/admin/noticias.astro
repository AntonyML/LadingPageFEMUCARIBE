---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="Gestión de Noticias" activeSection="noticias">
  <div class="module-header">
    <div>
      <span class="module-kicker">Comunicación y Prensa</span>
      <h1 class="module-title">Noticias y Comunicados</h1>
      <p class="module-desc">
        Creación, edición y programación de comunicados de prensa y noticias
        oficiales de FEMUCARIBE.
      </p>
    </div>
  </div>

  <section class="placeholder-card">
    <div class="card-icon" aria-hidden="true">
      <svg
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path>
        <path d="M18 14h-8"></path>
        <path d="M15 18h-5"></path>
        <path d="M10 6h8v4h-8V6Z"></path>
      </svg>
    </div>
    <h2>Gestor Editorial de Noticias</h2>
    <p>
      Módulo para redactar boletines informativos, subir fotografías
      institucionales y publicarlas de forma inmediata en la sala de prensa del
      portal público.
    </p>
  </section>
</AdminLayout>

<style>
  .module-header {
    margin-block-end: 2rem;
    padding-block-end: 1.5rem;
    border-block-end: 1px solid var(--theme-border);
  }

  .module-kicker {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--theme-action);
  }

  .module-title {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.75rem;
    font-weight: 800;
  }

  .module-desc {
    margin: 0;
    color: var(--theme-text-secondary);
  }

  .placeholder-card {
    background-color: var(--theme-surface);
    border: 1px dashed var(--theme-border);
    border-radius: 12px;
    padding: 3rem 2rem;
    text-align: center;
    max-inline-size: 40rem;
    margin: 2rem auto;
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 4rem;
    block-size: 4rem;
    border-radius: 50%;
    background-color: rgb(217 119 6 / 10%);
    color: #d97706;
    margin-block-end: 1.5rem;
  }

  .placeholder-card h2 {
    margin: 0 0 0.75rem;
    font-size: 1.375rem;
  }

  .placeholder-card p {
    margin: 0;
    color: var(--theme-text-secondary);
    line-height: 1.6;
  }
</style>
