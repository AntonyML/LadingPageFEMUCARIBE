---
import PublicLayout from '../layouts/PublicLayout.astro';
import MunicipalidadesPage from '../components/municipalidades/MunicipalidadesPage.astro';
import { fetchCmsMunicipalities } from '../lib/cms-municipalities';
import { presentMunicipalities } from '../components/municipalidades/data';

const municipalities = presentMunicipalities(await fetchCmsMunicipalities());
---

<PublicLayout title="Municipalidades | FEMUCARIBE">
  <MunicipalidadesPage municipalities={municipalities} />
</PublicLayout>
