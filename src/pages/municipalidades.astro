---
import PublicLayout from '../layouts/PublicLayout.astro';
import MunicipalidadesPage from '../components/municipalidades/MunicipalidadesPage.astro';
import { listMunicipalities } from '../lib/municipalities-repository';
import { presentMunicipalities } from '../components/municipalidades/data';

export const prerender = false;
Astro.cache.set(false);
Astro.response.headers.set('Cache-Control', 'no-store');
const municipalities = presentMunicipalities(await listMunicipalities());
---

<PublicLayout title="Municipalidades | FEMUCARIBE">
  <MunicipalidadesPage municipalities={municipalities} />
</PublicLayout>
